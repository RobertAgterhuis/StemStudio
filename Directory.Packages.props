<Project>
  <!-- Central Package Management: every NuGet version lives here (see ADR-007).
       Projects reference packages without a Version attribute. Licences are listed in
       docs/handoffs/architect-plan-and-skeleton.md. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup Label="Persistence">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup Label="Api">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
  </ItemGroup>
  <ItemGroup Label="Web">
    <PackageVersion Include="Radzen.Blazor" Version="13.1.0" />
    <!-- Help topics (feature 004): Markdown rendering, BSD-2-Clause; 1.5.1 because 1.6.0 was < 2 weeks old at pinning. -->
    <PackageVersion Include="Markdig" Version="1.5.1" />
  </ItemGroup>
  <ItemGroup Label="Agent">
    <!-- Feature 011 (ADR-020, research.md section 3): newest versions published >= 2 weeks before pinning (2026-11-15).
         The research values 11.0.0 / 5.5.2 / 13.8.0 were published 2026-11-05..11 and are too new.
         Microsoft.Extensions.AI 10.11.0 (MIT, 2026-10-14); OllamaSharp 5.5.0 (MIT, 2026-09-30; needs MEAI >= 10.8.0);
         Anthropic 13.3.0 (official C# SDK, Apache-2.0, 2026-10-24; needs MEAI.Abstractions >= 10.5.1). -->
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.11.0" />
    <PackageVersion Include="OllamaSharp" Version="5.5.0" />
    <PackageVersion Include="Anthropic" Version="13.3.0" />
  </ItemGroup>
  <ItemGroup Label="LyricAssist">
    <!-- Feature 023 (ADR-037, research R-02/R-10): managed Hunspell port for the deterministic spelling layer.
         7.0.1 (2025-11-30, net8.0/net10.0/netstandard2.0, no dependencies on net10.0) is the newest release.
         Licence: MPL-1.1 / GPL-2.0 / LGPL-2.1 tri-licence inherited from Hunspell (package license.txt);
         StemStudio uses it under MPL-1.1, unmodified. Dictionaries: src/StemStudio.Api/LyricAssist/Dictionaries/PROVENANCE.md. -->
    <PackageVersion Include="WeCantSpell.Hunspell" Version="7.0.1" />
  </ItemGroup>
  <ItemGroup Label="Shared">
    <!-- YAML: help-topic front matter in StemStudio.Web (runtime, feature 004) and OpenAPI parsing in the
         contract tests (JsonSchema.Net excluded: OSMF EULA, not OSI). MIT. -->
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>
  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="coverlet.msbuild" Version="10.1.0" />
    <PackageVersion Include="bunit" Version="2.15.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <!-- Feature 011: real container in the StemStudio.Agent DI tests (AddStemStudioAgent). MIT; same servicing band as EF Core / ASP.NET 10.0.15. -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="NSubstitute.Analyzers.CSharp" Version="1.0.17" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
  </ItemGroup>
</Project>
