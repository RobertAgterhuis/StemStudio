{
  "minLines": 6,
  "minTokens": 40,
  "format": ["csharp", "python", "typescript", "tsx", "razor"],
  "reporters": ["json"],
  "absolute": true,
  "silent": true,
  "gitignore": true,
  "ignore": [
    "**/bin/**",
    "**/obj/**",
    "**/node_modules/**",
    "**/.venv/**",
    "**/Migrations/**",
    "**/TestResults/**",
    "**/coverage/**",
    "**/dist/**",
    "**/__pycache__/**",
    "**/*.g.cs",
    "**/*.generated.cs",
    "**/*.Designer.cs",
    "**/*.d.ts",
    "**/wwwroot/js/audio-engine.js",
    "**/tools/quality/tests/samples/**",
    "**/stemstudio_worker/detail/vendor/**",
    "**/stemstudio_worker/transcription/vendor/**"
  ]
}
