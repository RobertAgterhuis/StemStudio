<?xml version="1.0" encoding="utf-8"?>
<!-- Shared coverage settings for coverlet.collector (dotnet test with collect "XPlat Code Coverage"), see ADR-007. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[StemStudio.*]*</Include>
          <Exclude>[StemStudio.*.Tests]*</Exclude>
          <ExcludeByFile>**/*.generated.cs,**/*.g.cs,**/Migrations/*.cs</ExcludeByFile>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute,ObsoleteAttribute</ExcludeByAttribute>
          <SkipAutoProps>true</SkipAutoProps>
          <DeterministicReport>false</DeterministicReport>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
