<Project Sdk="Microsoft.NET.Sdk">
  <!-- xUnit v3 + Shouldly + NSubstitute + coverlet come from Directory.Build.props. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\StemStudio.Web\StemStudio.Web.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="bunit" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>
  <ItemGroup>
    <!-- Help-content schemas (contracts/help-content.md 1.0.0), copied to <output>/Contracts/ for the help tests.
         One-time edit by the architect (feature 004, T003); the rest of this project is frontend-owned. -->
    <None Include="..\..\specs\004-design-system-ux\contracts\help-topic.schema.json;..\..\specs\004-design-system-ux\contracts\tour.schema.json"
          Link="Contracts\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- Default key map catalogue (web-interop 1.1.0, feature 014 T006, architect one-time edit): read by KeyMapDefaultsTests
         directly and through a web-root file provider (Practice/webroot/js/). -->
    <None Include="..\..\src\StemStudio.Web\wwwroot\js\keymap-defaults.json" Link="Practice\keymap-defaults.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\StemStudio.Web\wwwroot\js\keymap-defaults.json" Link="Practice\webroot\js\keymap-defaults.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- Recorded agent event streams (backend-api 1.10.0, feature 011) for the SSE reader and client tests. -->
    <None Include="Agent\Fixtures\*.sse" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- Run-time sentinel Claude keys (011 follow-up claude-key, architect T005); only the sentinels, the other shared
         doubles need StemStudio.Agent, which the Web app does not reference. -->
    <Compile Include="..\Shared\ClaudeKey\ClaudeKeySentinels.cs" LinkBase="Shared\ClaudeKey" />
  </ItemGroup>
  <ItemGroup>
    <!-- JSON Schema subset validator, shared with StemStudio.Api.Tests (moved from Skeleton/ by the architect, 013 Phase 0 T006). -->
    <Compile Include="..\Shared\JsonSchema\*.cs" LinkBase="Shared\JsonSchema" />
  </ItemGroup>
</Project>
