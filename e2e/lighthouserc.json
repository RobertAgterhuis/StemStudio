{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "throttlingMethod": "devtools",
        "chromeFlags": "--headless=new --no-sandbox --disable-dev-shm-usage",
        "onlyCategories": ["performance"]
      }
    },
    "assert": {
      "assertions": {
        "first-contentful-paint": ["error", { "maxNumericValue": 1000, "aggregationMethod": "median" }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 1500, "aggregationMethod": "median" }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05, "aggregationMethod": "median" }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./lighthouse-report"
    }
  }
}
