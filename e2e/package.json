{
  "name": "@stemstudio/e2e",
  "version": "0.1.0",
  "description": "StemStudio Playwright end-to-end suite (import -> separate -> mix -> save -> reload) against the docker compose stack.",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "test": "playwright test --project=chromium --project=firefox --grep-invert \"@real|@restart|@worker-restart|@gpu|@agent|@claude-key|@compose|@fresh-library|@library-db|@lyric-assist|@recording\"",
    "test:legacy": "playwright test --project=chromium --project=firefox --grep-invert \"@real|@restart|@worker-restart|@gpu|@ux|@artwork|@band-info|@export|@library|@karaoke|@lyrics|@sheet-music|@styles|@generation-status|@generative|@self-test|@agent|@claude-key|@practice|@library-care\"",
    "test:artwork": "playwright test --project=chromium --project=firefox --grep \"@artwork|@band-info\"",
    "test:export": "playwright test --project=chromium --project=firefox --grep \"@export|@library\" --grep-invert @detail",
    "test:ux": "playwright test --project=chromium --project=firefox --grep @ux",
    "test:lyrics": "playwright test --project=chromium --project=firefox --grep \"@karaoke|@lyrics\"",
    "test:sheet-music": "playwright test --project=chromium --project=firefox --grep @sheet-music --grep-invert @detail",
    "test:styles": "playwright test --project=chromium --project=firefox --grep \"@styles|@generation-status\"",
    "test:generative": "playwright test --project=chromium --project=firefox --grep @generative --grep-invert \"@restart|@agent\"",
    "test:generative-restart": "playwright test --project=chromium --project=firefox --grep \"@generative.*@restart|@restart.*@generative\"",
    "test:gpu": "playwright test --project=chromium --project=firefox --grep @gpu",
    "test:real": "playwright test --project=chromium --project=firefox --grep @real",
    "test:restart": "playwright test --project=chromium --project=firefox --grep @restart",
    "test:detail": "playwright test --project=chromium --project=firefox --grep @detail --grep-invert @worker-restart",
    "test:worker-restart": "playwright test --project=chromium --project=firefox --grep @worker-restart",
    "test:claude-key": "playwright test --project=chromium --project=firefox --grep @claude-key",
    "test:practice": "playwright test --project=chromium --project=firefox --grep @practice",
    "test:practice-flow": "playwright test --project=chromium --project=firefox --grep @practice-flow",
    "test:practice-flow-no-detect": "playwright test --project=chromium --grep \"(?=.*@practice-flow)(?=.*scenario 4)\"",
    "test:recording": "playwright test --project=recording --grep @recording",
    "test:library-care": "playwright test --project=chromium --project=firefox --grep @library-care --grep-invert \"@compose|@fresh-library\"",
    "test:library-care-compose": "playwright test --project=chromium --project=firefox --grep \"(?=.*@library-care)(?=.*@compose)\"",
    "test:library-db": "playwright test --project=chromium --grep @library-db",
    "test:lyric-assist": "playwright test --project=chromium --project=firefox --grep @lyric-assist --grep-invert \"@lyric-assist-none|@lyric-assist-claude|@agent\"",
    "test:lyric-assist-none": "playwright test --project=chromium --grep @lyric-assist-none",
    "test:lyric-assist-claude": "playwright test --project=chromium --grep @lyric-assist-claude",
    "test:library-care-fresh": "playwright test --project=chromium --grep @fresh-library",
    "test:visual": "playwright test --project=visual",
    "test:a11y": "playwright test --project=a11y",
    "test:lighthouse": "playwright test --project=lighthouse-setup && node lighthouse/run-lighthouse.mts",
    "list": "playwright test --list",
    "fixtures:generative": "uv run --project ../worker python ../tests/fixtures/generate_voice_fixtures.py",
    "fixtures:backup": "uv run --project ../worker python ../tests/fixtures/backup/make_hostile_archives.py && uv run --project ../worker python ../tests/fixtures/backup/make_schema_archives.py",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "fixtures": "uv run --project ../worker python ../tests/fixtures/generate_fixtures.py && uv run --project ../worker python ../tests/fixtures/generate_detail_fixtures.py && uv run --project ../worker python ../tests/fixtures/generate_artwork_fixtures.py && uv run --project ../worker python ../tests/fixtures/generate_lyrics_fixtures.py && uv run --project ../worker python ../tests/fixtures/generate_score_fixtures.py"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "eslint": "10.15.0",
    "eslint-plugin-jsdoc": "65.4.2",
    "eslint-plugin-playwright": "2.12.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  }
}
