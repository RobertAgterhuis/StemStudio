# StemStudio: optional variables of `docker compose up` (copy to .env and change what you need).
# Every value below is the default; an unset variable behaves the same. No secret belongs here:
# ANTHROPIC_API_KEY (feature 011) is passed from your shell only, never written into a file.
# The full list with explanations is the header of docker-compose.yml.

# Web and api: host address the ports 8080 and 8081 are published on (refactor 004, ADR-027 D3).
# Default 127.0.0.1 = this computer only. WARNING (threat T7): 0.0.0.0 or a LAN address lets
# every device on that network reach your library, backups and agent, and (until feature 018)
# overwrite or delete the stored Claude key. Leave it commented out unless you need LAN access.
# STEMSTUDIO_BIND_ADDRESS=127.0.0.1
# Api host allow-list (refactor 003): empty = localhost;127.0.0.1;[::1];api. With the ports opened,
# add the name or address the other devices use, or the api answers 400 to them, for example:
# STEMSTUDIO_API_ALLOWED_HOSTS=localhost;127.0.0.1;[::1];api;192.168.1.10

# Worker: separator and device (features 001-003).
STEMSTUDIO_SEPARATOR=demucs
STEMSTUDIO_DEVICE=cpu

# Worker: sheet music (feature 008). Empty = fake with the fake separator, else real.
STEMSTUDIO_TRANSCRIBER=

# Worker: section detection (feature 014). Empty = fake with the fake separator, else real.
STEMSTUDIO_STRUCTURE_ANALYZER=

# Worker: instrument views (feature 016). Empty = fake with the fake separator, else btc / pyin;
# empty threads = 4.
STEMSTUDIO_CHORD_ENGINE=
STEMSTUDIO_PITCH_ENGINE=
STEMSTUDIO_ANALYSIS_THREADS=

# Worker: stem quality reports (feature 020). Empty = fake with the fake separator, else real;
# empty threads = 4 (1..16).
STEMSTUDIO_QUALITY_ANALYZER=
STEMSTUDIO_INSIGHTS_THREADS=

# API: a stem quality report after every separation (feature 020, StemStudio__AutoQualityReport).
STEMSTUDIO_AUTO_QUALITY_REPORT=true

# API: detect sections right after every separation (feature 014,
# StemStudio__Practice__SectionDetectOnComplete).
STEMSTUDIO_SECTION_DETECT_ON_COMPLETE=true

# API and web: largest take upload in bytes (feature 015, StemStudio__Recording__MaxUploadBytes
# for the api and StemStudio__Recording__MaxStreamBytes for the web; 268435456 = 256 MiB).
STEMSTUDIO_RECORDING_MAX_UPLOAD_BYTES=268435456

# API: backups folder on the host (feature 013), created before the first start.
STEMSTUDIO_BACKUP_HOST_DIR=./backups
