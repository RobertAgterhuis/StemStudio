# Build context = repository root (see docker-compose.yml). Keep the context small and free of
# local state: the images need only sources, lock files and the shared build props.
.git
.github
.claude
.specify
.remember
.vs
.vscode
.idea
**/.env
**/.env.*
docs
specs
e2e
tools
scripts
# ...except the SoundTouch build script (web image, feature 012), which also ships in the image
!scripts/build-soundtouch.sh
!scripts/build-soundtouch.ps1
docker-compose*.yml

# .NET outputs and test projects (tests run in CI, not in images)
**/bin
**/obj
**/TestResults
**/coverage
tests

# Python
**/.venv
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/.coverage
**/htmlcov
worker/tests

# Node
**/node_modules
**/dist
# Built inside the web image; never copy a stale local bundle
src/StemStudio.Web/wwwroot/js/audio-engine.js
src/StemStudio.Web/wwwroot/js/audio-engine.js.map
src/StemStudio.Web/wwwroot/js/web-interop.js
src/StemStudio.Web/wwwroot/js/web-interop.js.map
src/StemStudio.Web/wwwroot/js/first-paint.js
src/StemStudio.Web/wwwroot/js/first-paint.js.map
src/StemStudio.Web/wwwroot/js/time-stretch-processor.js
src/StemStudio.Web/wwwroot/js/time-stretch-processor.js.map
src/StemStudio.Web/wwwroot/js/soundtouch
src/StemStudio.Web/wwwroot/third-party
# SoundTouch download and local build output (fetched and built inside the web image)
third_party/soundtouch/upstream
third_party/soundtouch/build

# Runtime data (013: backups/ holds multi-GB archives and must never reach a build context)
data
backups
**/*.db
**/*.db-shm
**/*.db-wal
