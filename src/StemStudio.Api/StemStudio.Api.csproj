<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- ASP.NET Core Minimal API (ADR-002). Owned by the backend agent. -->
  <PropertyGroup>
    <RootNamespace>StemStudio.Api</RootNamespace>
    <UserSecretsId>stemstudio-api</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\StemStudio.Domain\StemStudio.Domain.csproj" />
    <ProjectReference Include="..\StemStudio.Persistence\StemStudio.Persistence.csproj" />
    <ProjectReference Include="..\StemStudio.Contracts\StemStudio.Contracts.csproj" />
    <!-- Feature 011: the composer agent library (Api -> Agent -> Contracts; plan.md dependency direction). -->
    <ProjectReference Include="..\StemStudio.Agent\StemStudio.Agent.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Feature 023: Hunspell spelling layer (MPL-1.1 of the tri-licence). -->
    <PackageReference Include="WeCantSpell.Hunspell" />
  </ItemGroup>
  <ItemGroup>
    <!-- Feature 023 (T006): vendored dictionaries (PROVENANCE.md), copied byte-identical to the output and the publish folder. -->
    <None Update="LyricAssist\Dictionaries\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="LyricAssist\Dictionaries\**\*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
