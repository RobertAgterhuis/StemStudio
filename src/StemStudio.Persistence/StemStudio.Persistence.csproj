<Project Sdk="Microsoft.NET.Sdk">
  <!-- EF Core + SQLite persistence (ADR-002). Depends on Domain only. Owned by the backend agent. -->
  <PropertyGroup>
    <RootNamespace>StemStudio.Persistence</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="StemStudio.Persistence.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\StemStudio.Domain\StemStudio.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
