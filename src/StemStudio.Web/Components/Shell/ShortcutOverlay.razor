@* Shortcut overlay (004 FR-017; 014 FR-024): the live bindings of the current screen from the key map, with remapped and
   pedal keys, grouped as in the catalogue (ui-test-ids 1.13.0 shortcut-group-*, shortcut-row-* with data-keys). *@
@implements IAsyncDisposable
@inject ShellOverlays Overlays
@inject NavigationManager Navigation
@inject StemStudio.Web.Interop.IWebInterop Web
@inject StemStudio.Web.Preferences.PreferencesState Preferences
@using StemStudio.Web.Practice

<div class="ss-palette-backdrop" @onclick="Overlays.Close">
    <div class="ss-palette ss-shortcuts" role="dialog" aria-modal="true" aria-labelledby="shortcuts-title" data-testid="shortcut-overlay"
         tabindex="-1" @ref="_dialog" @onclick:stopPropagation="true" @onkeydown="Key">
        <header class="ss-help-head">
            <h2 id="shortcuts-title" class="ss-title">Keyboard shortcuts</h2>
            <button type="button" class="ss-bar-button" aria-label="Close shortcuts" data-testid="shortcut-overlay-close" @onclick="Overlays.Close">
                <span class="rzi" aria-hidden="true">close</span>
            </button>
        </header>
        <p class="ss-muted">Ctrl is Cmd on a Mac. Shortcuts do not work while you type in a field.</p>
        @if (!Preferences.Current.Shortcuts.SingleKey)
        {
            <p class="ss-help" role="note">Single-key shortcuts are off: only the Ctrl shortcuts work.</p>
        }
        @foreach (var group in Groups)
        {
            <table class="ss-shortcut-table" data-testid="@($"shortcut-group-{group.Group}")">
                <caption>@group.Title</caption>
                <tbody>
                    @foreach (var line in group.Lines)
                    {
                        <tr data-testid="@($"shortcut-row-{line.TestId}")" data-keys="@line.DataKeys">
                            <th scope="row"><kbd>@line.Text</kbd></th>
                            <td>@line.Label</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    private ElementReference _dialog;
    private IAsyncDisposable? _focus;

    private IReadOnlyList<ShortcutGroup> Groups => ShortcutOverview.Build(ShortcutKeys.Catalogue, Preferences.Current.Shortcuts, Scopes());

    /// <inheritdoc />
    public async ValueTask DisposeAsync() => await (_focus?.DisposeAsync() ?? ValueTask.CompletedTask);

    /// <inheritdoc />
    protected override async Task OnInitializedAsync() => _focus = await Web.CaptureFocusAsync();

    /// <inheritdoc />
    protected override Task OnAfterRenderAsync(bool firstRender) => firstRender ? _dialog.FocusAsync().AsTask() : Task.CompletedTask;

    // The keys of the current screen: everywhere, plus the mixer (with setlist play mode) or the library.
    private string[] Scopes()
    {
        var path = AppRoutes.CurrentPath(Navigation);
        if (AppRoutes.Matches("/tracks/{id}/mixer", path))
        {
            return ["global", "mixer", "setlist"];
        }

        return AppRoutes.Matches("/library", path) || AppRoutes.Matches("/library/{id}", path) ? ["global", "library"] : ["global"];
    }

    private void Key(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            Overlays.Close();
        }
    }
}
