@* A handout item in the library (020 US3/US4, FR-014; ui-test-ids asset-handout-*): facts, "Not included", renderer
   warnings (Advanced+), the PDF preview and download, and "Make again" (posts the recipe). *@

@using StemStudio.Contracts.Assets
<div class="ss-handout-item" data-wip-testid="@($"asset-handout-{Asset.Id}")" data-family="@FamilyValue">
    @if (Facts is { } facts)
    {
        <p class="ss-small">@HandoutText.Summary(facts)</p>
        @if (HandoutText.Omitted(facts) is { } omitted)
        {
            <p class="ss-small" data-wip-testid="@($"asset-handout-omitted-{Asset.Id}")">@omitted</p>
        }
        @if (facts.Warnings.Count > 0)
        {
            <LevelGate Feature="handout.customise">
                <ul class="ss-small ss-score-warnings" aria-label="@($"Warnings of {Asset.Name}")" data-wip-testid="@($"asset-handout-warnings-{Asset.Id}")">
                    @foreach (var warning in facts.Warnings)
                    {
                        <li>@warning.Text</li>
                    }
                </ul>
            </LevelGate>
        }
    }
    @if (Ready)
    {
        <PdfPreview Asset="Asset" Url="@FileUrl(ApiRoutes.AssetFilePdf, true)" Label="Handout preview" />
    }
    <div class="ss-row-actions">
        @if (Ready)
        {
            <a class="ss-row-action" href="@FileUrl(ApiRoutes.AssetFilePdf, false)" download aria-label="@($"Download PDF of {Asset.Name}")"
               data-wip-testid="@($"asset-download-pdf-{Asset.Id}")">Download PDF</a>
        }
        @if (CanMakeAgain)
        {
            <RadzenButton Text="Make again" Icon="refresh" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" aria-label="@($"Make again: {Asset.Name}")"
                          Click="() => OnMakeAgain.InvokeAsync(Asset)" data-wip-testid="@($"asset-handout-again-{Asset.Id}")" />
        }
    </div>
</div>

@code {
    /// <summary>The handout item.</summary>
    [Parameter, EditorRequired]
    public AssetDto Asset { get; set; } = default!;

    /// <summary>The browser URL of a file role (inline or as a download).</summary>
    [Parameter, EditorRequired]
    public Func<string, bool, string> FileUrl { get; set; } = default!;

    /// <summary>"Make again" pressed.</summary>
    [Parameter]
    public EventCallback<AssetDto> OnMakeAgain { get; set; }

    private HandoutFactsDto? Facts => Asset.Status == AssetStatusDto.Ready ? Asset.Handout : null;

    private bool Ready => Asset.Status == AssetStatusDto.Ready;

    private bool CanMakeAgain => Asset is { Status: AssetStatusDto.Ready or AssetStatusDto.Failed, Provenance.HandoutRecipe: not null };

    private string? FamilyValue => (Asset.Handout?.Family ?? Asset.Provenance.HandoutRecipe?.Family) is { } family ? HandoutText.Wire(family) : null;
}
