@* The suggestion list (FR-005, FR-006, FR-028; ui-test-ids lyric-assist-list): a listbox with aria-activedescendant; F8 /
   Shift+F8 move, Alt+Enter accepts, Alt+Backspace rejects, Alt+I marks as intentional, Escape goes back to the text. The
   per-entry buttons are reached by mouse or by these keys (they are not in the tab order). *@
@using StemStudio.Contracts.LyricAssist
@inherits AssistPart

@if (Session.Board.Visible is { Count: > 0 } visible)
{
    <ul id="@ListId" class="ss-assist-list" role="listbox" tabindex="0" aria-label="Suggestions" aria-activedescendant="@ActiveId" data-testid="lyric-assist-list"
        @onkeydown="OnKeyAsync" @onkeydown:stopPropagation="true" @onfocus="OnFocusAsync">
        @foreach (var s in visible)
        {
            <SuggestionEntry @key="s.SuggestionId" Host="Host" Suggestion="s" Active="s.SuggestionId == Session.Board.Active" OnSelect="SelectAsync" />
        }
    </ul>
}
else if (Session.Run is { IsActive: false })
{
    <p class="ss-small ss-muted">No open suggestions.</p>
}
