@* Assist log (Expert, FR-029): the newest assists with kind, status, blocks, timing, discarded items and token use. *@
@inherits AssistPart

<details class="ss-assist-panel" data-testid="lyric-assist-log" data-help-id="lyric-assist-privacy" @ontoggle="LoadAsync">
    <summary>Assist log</summary>
    <table class="ss-table ss-small">
        <thead><tr><th>Kind</th><th>Status</th><th>Blocks</th><th>Model</th><th>Discarded</th><th>Tokens</th></tr></thead>
        <tbody>
            @foreach (var a in Session.History)
            {
                <tr @key="a.AssistId">
                    <td>@AssistText.KindName(a.Kind)</td>
                    <td>@AssistText.Wire(a.Status)</td>
                    <td class="ss-num">@a.BlocksDone / @a.BlocksTotal (@a.BlocksSkipped skipped)</td>
                    <td>@(a.Model ?? "none")</td>
                    <td class="ss-num">@LogText.Discarded(a.Discarded)</td>
                    <td class="ss-num">@LogText.Tokens(a.Usage)</td>
                </tr>
            }
        </tbody>
    </table>
</details>

@code {
    private Task LoadAsync() => RunAsync(s => s.LoadHistoryAsync());
}
