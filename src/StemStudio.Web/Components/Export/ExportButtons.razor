@* "Save to library" buttons of the track page (feature 007, FR-001; ui-test-ids export-stem-<stem>,
   export-detail-<parent>-<detail>): one raw export per stem or detail stem, a separate row so the stem tabs keep their text. *@

@if (Channels.Count > 0)
{
    <div class="ss-export-row" data-help-id="export-actions">
        <span class="ss-small ss-muted">Save to library:</span>
        @foreach (var channel in Channels)
        {
            var label = channel[(channel.LastIndexOf('.') + 1)..];
            <button type="button" class="ss-text-button ss-export-button" aria-label="@($"Save {label} to the library")"
                    data-testid="@TestId(channel)" @onclick="() => OnExport.InvokeAsync(channel)">
                <span class="rzi" aria-hidden="true">library_add</span>@label
            </button>
        }
    </div>
}

@code {
    /// <summary>Channel ids in display order (<c>bass</c>, <c>drums.snare</c>).</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<string> Channels { get; set; } = [];

    /// <summary>Raised with the channel id to export.</summary>
    [Parameter]
    public EventCallback<string> OnExport { get; set; }

    private static string TestId(string channel) =>
        channel.Contains('.', StringComparison.Ordinal) ? $"export-detail-{channel.Replace('.', '-')}" : $"export-stem-{channel}";
}
