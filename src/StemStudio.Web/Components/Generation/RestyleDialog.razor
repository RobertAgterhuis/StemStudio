@* Restyle dialog (009 FR-001, FR-002, FR-015, FR-016; ui-test-ids 1.8.0 restyle-*): a style from the library, the
   options (Advanced: range, stems, strength, takes) and the personal-use notice. Every control is a native element so
   keyboards, screen readers and Playwright use it directly. *@
@using StemStudio.Web.Generation
@inherits ModalDialog

<div class="ss-modal-backdrop">
    <div class="ss-modal ss-restyle-dialog" role="dialog" aria-modal="true" aria-labelledby="restyle-title" data-testid="restyle-dialog"
         data-track-id="@Track.Id" data-help-id="restyle-options" @onkeydown="OnKeyAsync">
        <div class="ss-label-row">
            <h2 id="restyle-title" class="ss-title" tabindex="-1" @ref="InitialFocus">Restyle</h2>
            <HelpHint HelpId="restyle-options" />
        </div>
        <p class="ss-help">A new version of "@Track.Title" in another style. It is made on the GPU in the background.</p>

        @if (Form is { } form)
        {
            <label class="ss-field">
                <span class="ss-label">Style</span>
                <select class="rz-dropdown ss-select" value="@form.Style.Id" @onchange="OnStyleChanged" data-testid="restyle-style-select">
                    @foreach (var style in form.Styles)
                    {
                        <option value="@style.Id">@style.Name</option>
                    }
                </select>
            </label>
            <p class="ss-help" data-testid="restyle-style-description">@(form.Style.Description ?? "This style has no description.")</p>
            <LevelGate Feature="restyle.options">
                <RestyleOptions Form="form" OnChanged="StateHasChanged" />
            </LevelGate>
        }
        else if (Error is null)
        {
            <Skeleton Lines="3" />
        }

        <p class="ss-notice ss-small" role="note" data-testid="restyle-personal-use-notice" data-help-id="generation-personal-use">
            For personal use only: the result is AI-generated, is labelled as such and is not for publication. Styles describe
            music; they never imitate an artist. <HelpHint HelpId="generation-personal-use" />
        </p>

        @if (Error is not null)
        {
            <div class="ss-error" role="alert" data-testid="restyle-error">@Error</div>
        }
        <div class="ss-dialog-actions">
            <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="OnClose" data-testid="restyle-cancel" />
            @if (Form is not null)
            {
                <RadzenButton Text="Start" Icon="auto_awesome" IsBusy="Busy" BusyText="Starting..." Disabled="Busy" Click="StartAsync"
                              data-testid="restyle-start" />
            }
        </div>
    </div>
</div>
