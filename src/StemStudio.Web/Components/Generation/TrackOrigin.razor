@* Origin of a generated track on its page (009 FR-009, 010 FR-011/FR-013; ui-test-ids 1.8.0 track-origin-*, 1.9.0
   track-vocal-badge, track-lyrics-link): the AI-generated label, the AI voice label, a link to the source track while it
   exists and a link to the lyrics of a song. Imported tracks render nothing. *@

@if (Track.Origin is { AiGenerated: true } origin)
{
    <div class="ss-row ss-track-origin">
        <AiBadge TestId="track-origin-badge" />
        @if (origin.Vocal is { } vocal)
        {
            <VocalBadge TestId="track-vocal-badge" Vocal="vocal" ProfileName="@origin.VoiceProfileName" />
        }
        @if (origin.SourceTrackId is { } sourceId)
        {
            <a href="@($"tracks/{sourceId}")" data-testid="track-origin-source-link">Open the source song</a>
        }
        @if (origin.LyricsSheetId is { } sheetId)
        {
            <a href="@($"lyrics?sheet={sheetId}")" data-testid="track-lyrics-link">Open the lyrics</a>
        }
    </div>
}

@code {
    /// <summary>The track.</summary>
    [Parameter, EditorRequired]
    public TrackDto Track { get; set; } = default!;
}
