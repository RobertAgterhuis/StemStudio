@* Track page section "Restyled versions" (009 US1/US6, ui-test-ids 1.8.0 track-generations, track-restyle): the
   generation status, the restyle button (disabled, not hidden, with the reason when generation is not ready or the
   track is not separated yet) and the track's restyles with their takes. *@
@using StemStudio.Contracts.Generation
@using StemStudio.Web.Api
@using StemStudio.Web.Generation

<section class="ss-panel ss-track-generations" aria-labelledby="generations-heading" data-testid="track-generations">
    <div class="ss-label-row">
        <h2 id="generations-heading" class="ss-heading">Restyled versions</h2>
        <HelpHint HelpId="restyle-options" />
    </div>
    <GenerationStatusBanner />
    <div class="ss-row">
        <RadzenButton Text="Restyle" Icon="auto_awesome" Disabled="@(DisabledReasonId is not null)" Click="() => Restyling = true"
                      aria-describedby="@DisabledReasonId" data-testid="track-restyle" />
        @if (!TrackReady)
        {
            <span id="track-restyle-reason" class="ss-help ss-small">Restyle is possible once the track is separated.</span>
        }
    </div>
    <GenerationList @ref="List" Query="Query" EmptyText="No restyled versions yet." />
</section>

@if (Restyling)
{
    <RestyleDialog Track="Track" OnClose="() => Restyling = false" OnStarted="OnStartedAsync" />
}

@code {
    /// <summary>The track.</summary>
    [Parameter, EditorRequired]
    public TrackDto Track { get; set; } = default!;

    [Inject]
    private GenerationStatusSource StatusSource { get; set; } = default!;

    private GenerationStatusDto? Status { get; set; }

    private GenerationList? List { get; set; }

    private bool Restyling { get; set; }

    private GenerationQuery Query => new(GenerationKindDto.Restyle, Track.Id);

    private bool TrackReady => Track.Status == TrackStatusDto.Completed;

    private string? DisabledReasonId =>
        Status?.State != GenerationAvailabilityDto.Ready ? "generation-status-reason" : TrackReady ? null : "track-restyle-reason";

    /// <inheritdoc />
    protected override async Task OnInitializedAsync() => Status = await StatusSource.GetAsync();

    private async Task OnStartedAsync(GenerationDto generation)
    {
        Restyling = false;
        await List!.AddAsync(generation);
    }
}
