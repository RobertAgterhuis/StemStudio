@* "AI-generated" label of takes, generated tracks and library items (009 FR-008, 010 FR-011): a text badge, never colour
   alone. *@

<span class="ss-ai-badge" data-testid="@TestId" data-help-id="generation-ai-label">@Text</span>

@code {
    /// <summary>The <c>data-testid</c>, e.g. <c>take-ai-badge-&lt;id&gt;-1</c>; null renders none.</summary>
    [Parameter]
    public string? TestId { get; set; }

    /// <summary>The label: "AI-generated" (default) or the short "AI" of the track list.</summary>
    [Parameter]
    public string Text { get; set; } = "AI-generated";
}
