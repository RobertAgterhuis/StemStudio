@page "/dev/theme"
@using Microsoft.Extensions.Hosting
@inject IWebHostEnvironment Environment
@inject DialogService Dialogs
@* TEMPORARY theme spike (004 T012, ADR-013 D1): every Radzen component StemStudio uses, on the software
   base with the StemStudio token layer. Development only; removed after the go/no-go decision (T020). *@

<PageTitle>Theme spike - StemStudio</PageTitle>

@if (Environment.IsDevelopment())
{
    <h1>Theme spike</h1>
    <div id="spike">
        <div>
            <RadzenButton Text="Primary" />
            <RadzenButton Text="Light" ButtonStyle="ButtonStyle.Light" />
            <RadzenButton Text="Danger" ButtonStyle="ButtonStyle.Danger" />
            <RadzenButton Text="Success" ButtonStyle="ButtonStyle.Success" />
            <RadzenButton Text="Warning" ButtonStyle="ButtonStyle.Warning" />
            <RadzenButton Text="Outlined" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined" />
            <RadzenButton Text="Small" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" />
            <RadzenButton Icon="play_arrow" aria-label="Play" />
            <RadzenButton Text="Busy" IsBusy="true" BusyText="Busy..." />
            <RadzenButton Text="Disabled" Disabled="true" />
        </div>
        <div>
            <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="Completed" />
            <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="Failed" />
            <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="Separating" />
            <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="none" />
        </div>
        <RadzenCard>Card content</RadzenCard>
        <RadzenTextBox Placeholder="https://youtu.be/..." aria-label="Text" />
        <RadzenProgressBar Value="42" Max="100" ShowValue="true" aria-label="Progress" />
        <RadzenButton Text="Open dialog" Click="OpenDialog" />
    </div>
}

@code {
    private Task OpenDialog() => Dialogs.OpenAsync("Dialog", _ => b => b.AddContent(0, "Dialog body"));
}
