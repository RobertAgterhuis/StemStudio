@* Results of a completed track (design-spec.md 4.4): facts row, stem tabs and the way into the mixer. *@

<section class="ss-panel ss-summary" aria-labelledby="summary-heading">
    <h2 id="summary-heading" class="ss-heading">Stems</h2>
    <dl class="ss-facts ss-facts-row" data-help-id="track-facts">
        <div><dt>Tempo</dt><dd data-testid="track-bpm" data-help-id="track-bpm">@TrackFacts.Bpm(Track)</dd></div>
        <div><dt>Duration</dt><dd data-testid="track-duration">@TimeText.Duration(Track.DurationSeconds)</dd></div>
        <div><dt>Model</dt><dd data-testid="track-model">@TrackFacts.Model(Track)</dd></div>
    </dl>

    @if (TrackFacts.IsFallback(Track))
    {
        <p class="ss-help" data-testid="track-fallback-note">
            The 6-stem model was unavailable, so the 4-stem fallback model was used: guitar and piano are part of
            "other".
        </p>
    }

    <ul class="ss-stem-tabs" aria-label="Stems">
        @foreach (var stem in Track.Stems)
        {
            <li data-testid="@($"track-stem-{stem.Name}")"><StemTab Stem="@stem.Name" /></li>
        }
    </ul>
    <ChannelButtons Action="ChannelAction.Export" Channels="StemIds" OnSelect="OnExport" />
    <ChannelButtons Action="ChannelAction.Score" Channels="StemIds" OnSelect="OnScore" />
    <LevelGate Feature="export.stem-pack">
        <RadzenButton Text="Save all stems" Icon="library_add" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="OnExportAll"
                      data-testid="export-all-stems" data-help-id="export-actions" />
    </LevelGate>

    <a class="rz-button rz-button-md rz-variant-filled rz-primary rz-shade-default ss-link-button"
       href="@($"tracks/{Track.Id}/mixer")" data-testid="open-mixer" data-help-id="open-mixer">Open mixer</a>
</section>

@code {
    /// <summary>The completed track.</summary>
    [Parameter, EditorRequired]
    public TrackDto Track { get; set; } = default!;

    /// <summary>Raised with a stem name to save it raw to the library (feature 007).</summary>
    [Parameter]
    public EventCallback<string> OnExport { get; set; }

    /// <summary>Raised with a stem name to make sheet music of it (feature 008).</summary>
    [Parameter]
    public EventCallback<string> OnScore { get; set; }

    /// <summary>Raised to save every stem as its own item (feature 007, US5).</summary>
    [Parameter]
    public EventCallback OnExportAll { get; set; }

    private IReadOnlyList<string> StemIds => Track.Stems.Select(s => s.Name).ToList();
}
