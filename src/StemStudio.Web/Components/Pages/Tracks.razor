@page "/tracks"

<PageTitle>Tracks - StemStudio</PageTitle>

<div class="ss-page ss-page-wide ss-library">
    <header class="ss-page-head ss-page-head-row">
        <h1>Tracks</h1>
        @if (Items is { Count: > 0 })
        {
            <LevelGate Feature="tracks.search">
                <div class="ss-library-tools">
                    <label class="ss-sr-only" for="tracks-search">Search tracks</label>
                    <input id="tracks-search" type="search" class="rz-textbox ss-search" placeholder="Search tracks" value="@Search"
                           @oninput="OnSearch" data-testid="tracks-search" />
                    <label class="ss-inline-label" for="tracks-sort">Sort</label>
                    <select id="tracks-sort" class="ss-select" @onchange="OnSort" data-testid="tracks-sort">
                        <option value="newest">Newest first</option>
                        <option value="oldest">Oldest first</option>
                        <option value="title">Title A-Z</option>
                        <option value="artist">Artist A-Z</option>
                    </select>
                </div>
            </LevelGate>
        }
    </header>

    @if (Error is not null)
    {
        <ErrorState TestId="tracks-error" Message="@Error" Hint="Check that StemStudio is running, then reload the page." />
    }
    else if (Items is null)
    {
        <Skeleton Lines="4" />
    }
    else if (Items.Count == 0)
    {
        <EmptyState TestId="tracks-empty" Text="No tracks yet."><a href="">Import a song</a> to get started.</EmptyState>
    }
    else if (Visible.Count == 0)
    {
        <p class="ss-no-results" role="status">No tracks match "@Search".</p>
    }
    else
    {
        <TrackTable Tracks="Visible" Expert="IsExpert" Beginner="IsBeginner" />
    }
</div>
