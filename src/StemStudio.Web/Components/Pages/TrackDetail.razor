@page "/tracks/{Id:guid}"
@inherits PollingComponent

<PageTitle>Track - StemStudio</PageTitle>

@if (LoadError is not null)
{
    <ErrorState TestId="track-load-error" Message="@LoadError" Hint="The track may have been deleted."><a href="tracks">Back to tracks</a></ErrorState>
}
else if (Track is null)
{
    <Skeleton Lines="5" />
}
else
{
    <SectionContent SectionName="@ContextBar.JourneySection"><JourneyRail Stage="JourneyStages.ForTrack(Track.Status)" /></SectionContent>
    <div class="ss-page ss-track">
        <header class="ss-track-head">
            <TrackArtwork Track="Track" TestId="track-cover" HelpId="artwork" />
            <div class="ss-track-names">
                <h1 data-testid="track-title">@Track.Title</h1>
                @if (Track.Artist is not null)
                {
                    <p class="ss-track-artist">@Track.Artist</p>
                }
                <div class="ss-meta-row">
                    <span class="ss-meta-status" data-testid="metadata-status" data-status="@MetadataStatusText.Value(Track.Metadata.Status)">@MetadataStatusText.Label(Track.Metadata.Status)</span>
                    <BandInfoToggle Open="ShowBandInfo" OnToggle="ToggleBandInfo" />
                </div>
                <TrackOrigin Track="Track" />
                <ArtworkActions Track="Track" OnChanged="SetTrack" />
            </div>
            <StemRibbon Stems="StemList" TestId="track-ribbon" />
        </header>

        @if (ShowBandInfo)
        {
            <BandInfoPanel Track="Track" OnClose="ToggleBandInfo" OnChanged="OnBandInfoChangedAsync" />
        }

        <TrackProcessing Track="Track">
            @if (ActionError is not null)
            {
                <ErrorState TestId="track-action-error" Message="@ActionError" />
            }

            @if (Track.Status == TrackStatusDto.Failed)
            {
                <ErrorState TestId="track-error" Message="@(Track.Error ?? string.Empty)" />
                @if (RetryFailedAgain)
                {
                    <ErrorState TestId="track-retry-failed-again" Message="The retry failed again." Hint="Check the source link or try another file." />
                }
                <RadzenButton Text="Retry" Icon="refresh" Click="RetryAsync" IsBusy="IsRetrying" BusyText="Retrying..."
                              Disabled="IsRetrying" data-testid="track-retry" data-help-id="track-retry" />
            }

            @if (DeleteBlockedReason is not null)
            {
                <div class="ss-error" role="alert" data-testid="track-delete-blocked">
                    @DeleteBlockedReason Cancel the detail phase or wait until it has finished, then delete the track.
                </div>
            }

            @if (Track.Status == StemStudio.Contracts.Tracks.TrackStatusDto.Completed)
            {
                <div class="ss-row"><StemStudio.Web.Components.Practice.AddToSetlist TrackId="Track.Id" /></div>
            }

            @if (CanDelete)
            {
                <div class="ss-row ss-delete">
                    @if (ConfirmingDelete)
                    {
                        <span role="alert">This deletes the track, its stems and all of its mixes.</span>
                        <StemStudio.Web.Components.Recording.TrackDeleteTakesNote Count="Track.TakeCount" />
                        <RadzenButton Text="Delete" ButtonStyle="ButtonStyle.Danger" Click="DeleteAsync" IsBusy="IsDeleting"
                                      BusyText="Deleting..." Disabled="IsDeleting" data-testid="track-delete-confirm" />
                        <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="CancelDelete" Disabled="IsDeleting"
                                      data-testid="track-delete-cancel" />
                    }
                    else
                    {
                        <RadzenButton Text="Delete track" Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined"
                                      Click="AskDelete" data-testid="track-delete" data-help-id="track-delete" />
                    }
                </div>
            }
        </TrackProcessing>

        <JobDetails Track="Track" />

        @if (Track.Status == TrackStatusDto.Completed)
        {
            <TrackSummary Track="Track" OnExport="OpenExport" OnExportAll="OpenStemPack" OnScore="OpenScore" />
            <DetailSection Track="Track" Busy="IsDetailBusy" OnStart="StartDetailAsync" OnCancel="CancelDetailAsync" OnExport="OpenExport"
                           OnScore="OpenScore" />
            @if (Guitarist)
            {
                <StemStudio.Web.Components.InstrumentViews.CapoMode TrackId="Track.Id" OnChanged="OnCapoChanged" />
            }
            <LyricsSection Track="Track" Capo="ScoreCapo" />
        }
        <TrackGenerations Track="Track" />
    </div>
}

@if (Exporting is not null)
{
    <ExportDialog Target="Exporting" OnClose="CloseExport" />
}

@if (Scoring is not null)
{
    <ScoreDialog Target="Scoring" OnClose="CloseScoreAsync" />
}
