@* Input device and channel mode with the live meter (FR-001, FR-002; ui-test-ids 1.14.0 rec-device-select, rec-input-mode
   Advanced). Option values are device labels; the last used input is preselected. *@

<div class="ss-practice-row">
    <label for="rec-device">Input</label>
    <select id="rec-device" class="rz-dropdown" value="@Setup.Input?.Label" disabled="@Disabled" @onchange="DeviceChanged"
            data-testid="rec-device-select" data-help-id="recording-connect-vocals">
        @foreach (var device in Labelled)
        {
            <option value="@device.Label">@device.Label</option>
        }
    </select>
    <LevelGate Feature="recording.input-mode">
        <label for="rec-mode">Channels</label>
        <select id="rec-mode" class="rz-dropdown" value="@ModeValue" disabled="@Disabled" @onchange="ModeChanged" data-testid="rec-input-mode"
                data-help-id="recording">
            @foreach (var (mode, label) in RecordingText.Modes)
            {
                <option value="@WireName(mode)">@label</option>
            }
        </select>
    </LevelGate>
</div>
<InputMeter />
@if (Setup.Problem is { } problem)
{
    <p class="ss-help" role="alert" data-testid="rec-input-problem">@problem</p>
}

@code {
    /// <summary>The input state.</summary>
    [Parameter, EditorRequired]
    public InputSetup Setup { get; set; } = default!;

    /// <summary>True while recording (device changes are blocked).</summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>A device label was chosen.</summary>
    [Parameter]
    public EventCallback<string> OnDevice { get; set; }

    /// <summary>A mode was chosen.</summary>
    [Parameter]
    public EventCallback<InputChannelModeDto> OnMode { get; set; }

    private IEnumerable<InputDevice> Labelled => Setup.Devices.Where(d => d.Label.Length > 0).DistinctBy(d => d.Label);

    private string ModeValue => WireName(Setup.Settings.InputMode);

    private static string WireName(InputChannelModeDto mode) => StemStudio.Web.Services.WireName.Of(mode);

    private Task DeviceChanged(ChangeEventArgs args) => args.Value is string label ? OnDevice.InvokeAsync(label) : Task.CompletedTask;

    private Task ModeChanged(ChangeEventArgs args) =>
        RecordingText.Modes.FirstOrDefault(m => WireName(m.Mode) == args.Value as string) is { Label: not null } match
            ? OnMode.InvokeAsync(match.Mode)
            : Task.CompletedTask;
}
