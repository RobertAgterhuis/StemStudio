@* Processing device of a job or of the worker (FR-006, ui-test-ids 1.2.0). *@

<span class="ss-device">
    <span class="ss-device-name" data-testid="@TestId" data-device="@Display.Kind"
          data-fallback="@FallbackAttribute">@Display.Text</span>
    @if (Display.Reason is not null)
    {
        <span class="ss-device-reason" data-testid="@ReasonTestId">@Display.Reason</span>
    }
</span>

@code {
    /// <summary>What to show.</summary>
    [Parameter, EditorRequired]
    public DeviceDisplay Display { get; set; } = default!;

    /// <summary><c>data-testid</c> of the device text.</summary>
    [Parameter, EditorRequired]
    public string TestId { get; set; } = string.Empty;

    /// <summary><c>data-testid</c> of the reason text.</summary>
    [Parameter, EditorRequired]
    public string ReasonTestId { get; set; } = string.Empty;

    // A null attribute value makes Blazor leave the attribute out.
    private string? FallbackAttribute => Display.Fallback is { } fallback ? (fallback ? "true" : "false") : null;
}
