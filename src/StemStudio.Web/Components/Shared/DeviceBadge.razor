@* Processing device of a job or of the worker (FR-006, ui-test-ids 1.2.0). Everything is spelled out in text,
   never conveyed by colour alone (T047). *@

<span class="ss-device">
    <span class="ss-device-label">@Label:</span>
    <span class="ss-device-name" data-testid="@TestId" data-device="@Display.Kind"
          data-fallback="@FallbackAttribute">@Display.Text</span>
    @if (Display.Reason is not null)
    {
        <span class="ss-device-reason" role="note">
            <span class="ss-device-reason-label">@ReasonLabel</span>
            <span data-testid="@ReasonTestId">@Display.Reason</span>
        </span>
    }
</span>

@code {
    /// <summary>What to show.</summary>
    [Parameter, EditorRequired]
    public DeviceDisplay Display { get; set; } = default!;

    /// <summary><c>data-testid</c> of the device text.</summary>
    [Parameter, EditorRequired]
    public string TestId { get; set; } = string.Empty;

    /// <summary><c>data-testid</c> of the reason text.</summary>
    [Parameter, EditorRequired]
    public string ReasonTestId { get; set; } = string.Empty;

    /// <summary>Visible label in front of the device text.</summary>
    [Parameter]
    public string Label { get; set; } = "Device";

    // A null attribute value makes Blazor leave the attribute out.
    private string? FallbackAttribute => Display.Fallback is { } fallback ? (fallback ? "true" : "false") : null;

    // A job reason explains a fallback; a worker reason (no fallback flag) explains why the GPU is not used.
    private string ReasonLabel => Display.Fallback == true ? "CPU fallback:" : "GPU not used:";
}
