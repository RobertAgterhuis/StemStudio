@* Start and end of a range in seconds (feature 007 export range, feature 008 score range); empty = the whole song. *@

<div class="ss-range-row">
    <label class="ss-field">
        <span class="ss-small">Start (s)</span>
        <input type="number" min="0" step="0.1" class="rz-textbox" placeholder="0" @bind="Range.Start" @bind:event="oninput"
               data-testid="@($"{Prefix}-start")" data-help-id="@HelpId" />
    </label>
    <label class="ss-field">
        <span class="ss-small">End (s)</span>
        <input type="number" min="0" step="0.1" class="rz-textbox" placeholder="end" @bind="Range.End" @bind:event="oninput"
               data-testid="@($"{Prefix}-end")" />
    </label>
</div>

@code {
    /// <summary>The range as typed.</summary>
    [Parameter, EditorRequired]
    public StemStudio.Web.Export.RangeInput Range { get; set; } = default!;

    /// <summary>Test id prefix: <c>export-range</c> or <c>score-range</c>.</summary>
    [Parameter, EditorRequired]
    public string Prefix { get; set; } = string.Empty;

    /// <summary>Help marker of the start field.</summary>
    [Parameter, EditorRequired]
    public string HelpId { get; set; } = string.Empty;
}
