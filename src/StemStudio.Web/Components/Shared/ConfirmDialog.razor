@* Content of the Radzen confirmation dialog opened by DialogConfirmService. *@
@inject DialogService Dialogs

<p class="ss-dialog-message" data-testid="confirm-dialog-message">@Message</p>
@if (TestId is not null)
{
    <span hidden data-testid="@TestId"></span>
}
<div class="ss-dialog-actions">
    <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="@(() => Dialogs.Close(false))"
                  data-testid="confirm-dialog-cancel" />
    <RadzenButton Text="@OkText" ButtonStyle="ButtonStyle.Danger" Click="@(() => Dialogs.Close(true))"
                  data-testid="confirm-dialog-ok" />
</div>

@code {
    /// <summary>The question shown to the user.</summary>
    [Parameter, EditorRequired]
    public string Message { get; set; } = string.Empty;

    /// <summary>Text of the confirming button.</summary>
    [Parameter]
    public string OkText { get; set; } = "OK";

    /// <summary>Optional test id that marks which question is asked (e.g. <c>chords-overwrite-confirm</c>).</summary>
    [Parameter]
    public string? TestId { get; set; }
}
