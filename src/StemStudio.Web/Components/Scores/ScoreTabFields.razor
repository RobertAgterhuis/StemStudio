@* Tablature options of the sheet music dialog (016 US2, FR-020; ui-test-ids score-tab-*): layout, tuning and, for guitar,
   the capo (Advanced). Tuning names come from the instrument catalogue. *@
@using StemStudio.Contracts.InstrumentViews
@using StemStudio.Web.InstrumentViews

<fieldset class="ss-score-tab">
    <legend class="ss-label">Tablature <HelpHint HelpId="score-tablature" /></legend>
    <div class="ss-field">
        <label class="ss-label" for="score-tab-layout">Layout</label>
        <select id="score-tab-layout" class="ss-select" @bind:get="Tab.LayoutValue" @bind:set="SetLayout" data-testid="score-tab-layout" data-help-id="score-tablature">
            <option value="@TabChoice.NotationAndTabValue">Notation and tab</option>
            <option value="@TabChoice.TabOnlyValue">Tab only</option>
            <option value="@TabChoice.NoneValue">No tab</option>
        </select>
    </div>
    @if (Tab.Layout != TabLayoutChoice.None)
    {
        <div class="ss-field">
            <label class="ss-label" for="score-tab-tuning">Tuning</label>
            <select id="score-tab-tuning" class="ss-select" @bind:get="WireName.Of(Tab.Tuning)" @bind:set="SetTuning" data-testid="score-tab-tuning" data-help-id="score-tab-tuning">
                @foreach (var tuning in Tab.Tunings(AllTunings))
                {
                    <option value="@WireName.Of(tuning)">@TuningLabel(tuning)</option>
                }
            </select>
        </div>
        @if (Tab.CapoAllowed)
        {
            <LevelGate Feature="tab.tunings">
                <div class="ss-field">
                    <label class="ss-label" for="score-tab-capo">Capo</label>
                    <input id="score-tab-capo" type="number" class="ss-input" min="0" max="@ContractLimits.CapoMax" step="1"
                           @bind:get="Tab.Capo" @bind:set="SetCapo" @bind:event="onchange" data-testid="score-tab-capo" />
                </div>
            </LevelGate>
        }
    }
</fieldset>

@code {
    /// <summary>The tablature choices.</summary>
    [Parameter, EditorRequired]
    public TabChoice Tab { get; set; } = default!;

    /// <summary>The cascaded level.</summary>
    [CascadingParameter]
    public ExperienceContext? Experience { get; set; }

    [Inject]
    private InstrumentCatalogueCache Catalogue { get; set; } = default!;

    private IReadOnlyDictionary<TuningIdDto, string> Labels { get; set; } = new Dictionary<TuningIdDto, string>();

    private bool AllTunings => (Experience ?? ExperienceContext.Default).IsVisible("tab.tunings");

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        try
        {
            Labels = (await Catalogue.GetAsync()).Tunings.ToDictionary(t => t.Id, t => t.Label);
        }
        catch (ApiException)
        {
            // Without the catalogue the wire names are shown.
        }
    }

    private string TuningLabel(TuningIdDto tuning) => Labels.TryGetValue(tuning, out var label) ? label : WireName.Of(tuning);

    private void SetLayout(string? value) => Tab.LayoutValue = value ?? TabChoice.NotationAndTabValue;

    private void SetTuning(string? value)
    {
        foreach (var tuning in Tab.Tunings(all: true).Where(t => WireName.Of(t) == value))
        {
            Tab.Tuning = tuning;
        }
    }

    private void SetCapo(int capo) => Tab.Capo = Math.Clamp(capo, 0, ContractLimits.CapoMax);
}
