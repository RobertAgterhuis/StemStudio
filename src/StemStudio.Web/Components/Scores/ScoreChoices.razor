@* The choices of the sheet music dialog (feature 008): instrument profile with its quality note and expected time,
   simplified rhythm, key override (Advanced) and the manual tempo. *@
@using StemStudio.Contracts.Scores

<div class="ss-field">
    <label class="ss-label" for="score-profile">Instrument</label>
    <select id="score-profile" class="ss-select" value="@(Form.Profile is { } p ? ScoreText.Value(p) : string.Empty)" @onchange="OnProfile"
            data-testid="score-profile" data-help-id="sheet-music-profiles">
        @if (Form.Options.SuggestedProfile is null)
        {
            <option value="">Choose an instrument</option>
        }
        @foreach (var profile in Form.Options.AllowedProfiles)
        {
            <option value="@ScoreText.Value(profile)">@ScoreText.Label(profile)</option>
        }
    </select>
</div>

@if (Form.HasQuality)
{
    <LevelGate Feature="score.quality">
        <div class="ss-field">
            <label class="ss-label" for="score-quality">Quality</label>
            <select id="score-quality" class="ss-select" value="@Form.Quality.ToString().ToLowerInvariant()" @onchange="OnQuality"
                    data-testid="score-quality" data-help-id="sheet-music-piano">
                @foreach (var quality in Qualities)
                {
                    <option value="@quality.ToString().ToLowerInvariant()">@Form.QualityLabel(quality)</option>
                }
            </select>
        </div>
    </LevelGate>
}
@if (Form.Limit is { } limit)
{
    <p class="ss-help" data-testid="score-limits">@limit</p>
}
@if (Form.Estimate is { } estimate)
{
    <p class="ss-small ss-muted">Expected time: <span data-testid="score-estimate">@estimate</span></p>
}

<label class="ss-check">
    <input type="checkbox" checked="@Form.Simplified" @onchange="OnSimplified" data-testid="score-resolution" />
    Simplified rhythm (eighth notes)
</label>

@if (Form.HasKey)
{
    <LevelGate Feature="score.key-override">
        <div class="ss-field">
            <label class="ss-label" for="score-key">Key</label>
            <select id="score-key" class="ss-select" value="@Form.KeyOverride" @onchange="OnKey" data-testid="score-key-override"
                    data-help-id="sheet-music-key-tempo">
                <option value="">Automatic (estimated from the notes)</option>
                @foreach (var key in ContractLimits.KeyNames)
                {
                    <option value="@key">@ScoreText.KeyName(key)</option>
                }
            </select>
        </div>
    </LevelGate>
}

@if (Form.ShowsTab)
{
    <ScoreTabFields Tab="Form.Tab!" />
}

@if (Form.ShowsPart)
{
    <ScorePartFields Part="Form.Part!" ShowsClef="Form.ShowsClef" />
}

@if (Form.ChordsAllowed)
{
    <LevelGate Feature="scores.chords">
        <label class="ss-check">
            <input type="checkbox" checked="@(Form.ChordsAvailable && Form.IncludeChords)" disabled="@(!Form.ChordsAvailable)"
                   aria-describedby="@(Form.ChordsAvailable ? null : "score-include-chords-reason")" @onchange="OnIncludeChords"
                   data-testid="score-include-chords" />
            Include chords above the top staff
        </label>
        @if (!Form.ChordsAvailable)
        {
            <p id="score-include-chords-reason" class="ss-help ss-small">Chords are not ready for this track yet; they can be added once they are detected.</p>
        }
    </LevelGate>
}

<ScoreTempoFields Tempo="Form.Tempo" />

<LevelGate Feature="score.range">
    <fieldset>
        <legend class="ss-label">Part of the song (optional, at least 2 s) <HelpHint HelpId="sheet-music" /></legend>
        <RangeFields Range="Form.Range" Prefix="score-range" HelpId="sheet-music" />
    </fieldset>
</LevelGate>

@code {
    /// <summary>The dialog's choices.</summary>
    [Parameter, EditorRequired]
    public ScoreForm Form { get; set; } = default!;

    /// <summary>Raised after a choice changed, so the dialog re-renders its buttons.</summary>
    [Parameter]
    public EventCallback OnChanged { get; set; }

    private static readonly ScoreQualityDto[] Qualities = [ScoreQualityDto.Accurate, ScoreQualityDto.Fast];

    private void OnQuality(ChangeEventArgs args) =>
        Form.Quality = args.Value?.ToString() == "accurate" ? ScoreQualityDto.Accurate : ScoreQualityDto.Fast;

    private void OnSimplified(ChangeEventArgs args) => Form.Simplified = args.Value is true;

    private void OnIncludeChords(ChangeEventArgs args) => Form.IncludeChords = args.Value is true;

    private void OnKey(ChangeEventArgs args) => Form.KeyOverride = args.Value?.ToString() ?? string.Empty;

    private Task OnProfile(ChangeEventArgs args)
    {
        Form.SetProfile(Enum.TryParse<ScoreProfileDto>(args.Value?.ToString(), ignoreCase: true, out var profile) ? profile : null);
        return OnChanged.InvokeAsync();
    }
}
