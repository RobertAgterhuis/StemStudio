@* Worker details at Expert (013 US3; ui-test-ids 1.12.0 storage-worker-entries): one row per worker cache entry
   (backend-api 1.12.0 StorageOverview.workerEntries), largest first, with the track whose standard job uses it. *@

<table class="ss-table ss-care-storage-table" data-testid="storage-worker-entries">
    <caption class="ss-label">Worker cache entries</caption>
    <thead><tr><th scope="col">Entry</th><th scope="col">Size</th><th scope="col">In use</th><th scope="col">From library</th><th scope="col">Track</th></tr></thead>
    <tbody>
        @if (Entries.Count == 0)
        {
            <tr><td colspan="5">No worker cache entries.</td></tr>
        }
        @foreach (var entry in Entries)
        {
            <tr @key="entry.AudioSha256Prefix">
                <th scope="row"><code>@entry.AudioSha256Prefix</code></th>
                <td class="ss-num">@StorageView.Size(entry.Bytes)</td>
                <td>@YesNo(entry.InUse)</td>
                <td>@YesNo(entry.FromLibrary)</td>
                <td>
                    @if (TitleOf(entry.TrackId) is { } title)
                    {
                        <a href="@($"tracks/{entry.TrackId}")">@title</a>
                    }
                    else
                    {
                        <span>-</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@code {
    /// <summary>The worker cache entries of the overview.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<WorkerCacheEntryStorageDto> Entries { get; set; } = [];

    /// <summary>The per-track rows, for the track titles.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<TrackStorageDto> Tracks { get; set; } = [];

    private static string YesNo(bool value) => value ? "Yes" : "No";

    private string? TitleOf(Guid? trackId) => trackId is null ? null : Tracks.FirstOrDefault(track => track.TrackId == trackId)?.Title;
}
