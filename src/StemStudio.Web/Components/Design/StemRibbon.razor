@* Stem ribbon (design-spec.md 1): a grey strand that splits into the six stem lines; missing stems stay grey and a
   track without stems is a single grey strand. Decorative; the stem names are written elsewhere. *@

<svg class="ss-ribbon" viewBox="0 0 48 14" width="48" height="14" aria-hidden="true" focusable="false"
     data-testid="@TestId" data-stems="@string.Join(',', Ordered)">
    @if (Ordered.Count == 0)
    {
        <path class="ss-ribbon-song" d="M1 7H47" />
    }
    else
    {
        <path class="ss-ribbon-song" d="M1 7H14" />
        @for (var i = 0; i < StemNames.SixStem.Count; i++)
        {
            var stem = StemNames.SixStem[i];
            var y = 2 + (i * 2);
            <path class="@StrandClass(stem)" d="@($"M14 7C19 7 18 {y} 23 {y}H47")" />
        }
    }
</svg>

@code {
    /// <summary>Stem names of the track (any order).</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<string> Stems { get; set; } = [];

    /// <summary><c>data-testid</c> of the ribbon.</summary>
    [Parameter, EditorRequired]
    public string TestId { get; set; } = string.Empty;

    private List<string> Ordered => StemNames.SixStem.Where(Stems.Contains).ToList();

    private string StrandClass(string stem) =>
        Stems.Contains(stem) ? $"ss-ribbon-strand ss-stroke-{stem}" : "ss-ribbon-strand ss-ribbon-missing";
}
