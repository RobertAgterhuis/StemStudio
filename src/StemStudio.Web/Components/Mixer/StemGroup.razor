@* Detail strips of an expanded parent (group-<parent>), each with fader, pan, mute, solo and meter (FR-012). *@

<div class="ss-group" role="group" id="@($"group-{Group.Parent}")" aria-label="@($"{Group.Parent} detail stems")"
     data-testid="@($"group-{Group.Parent}")" style="@($"--stem-color: {StemColor.Var(Group.Parent)}")">
    @for (var i = 0; i < Group.Stems.Count; i++)
    {
        var stem = Group.Stems[i];
        var id = stem.Id;
        <ChannelStrip Channel="stem.Channel" Audible="IsAudible(stem.Channel)" Pattern="i"
                      OnVolume="v => OnVolume.InvokeAsync(new(id, v))" OnPan="p => OnPan.InvokeAsync(new(id, p))"
                      OnMute="() => OnMute.InvokeAsync(id)" OnSolo="() => OnSolo.InvokeAsync(id)">
            @if (Track is not null)
            {
                <StemStudio.Web.Components.InstrumentViews.MidiAction Track="Track" Channel="@id" />
            }
            @if (Track is not null && Quality?.Invoke(id) is { } quality)
            {
                <QualityBadge TrackId="Track.Id" Stem="quality" />
            }
        </ChannelStrip>
    }
</div>
