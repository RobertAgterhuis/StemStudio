@* Expand/collapse button of a split parent (FR-012); busy while the engine loads the group. *@

<RadzenButton Text="@(Expanded ? "Collapse" : "Expand")" Icon="@(Expanded ? "unfold_less" : "unfold_more")"
              Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" class="ss-expand" IsBusy="Busy" BusyText="Loading..."
              aria-expanded="@(Expanded ? "true" : "false")" aria-controls="@($"group-{Parent}")"
              aria-label="@($"{(Expanded ? "Hide" : "Show")} detail stems of {Parent}")" Click="OnToggle"
              data-testid="@($"expand-{Parent}")" />

@code {
    /// <summary>The split parent.</summary>
    [Parameter, EditorRequired]
    public string Parent { get; set; } = string.Empty;

    /// <summary>True while the parent is expanded.</summary>
    [Parameter]
    public bool Expanded { get; set; }

    /// <summary>True while the engine is loading or swapping the group.</summary>
    [Parameter]
    public bool Busy { get; set; }

    /// <summary>Raised when the user toggles the group.</summary>
    [Parameter]
    public EventCallback OnToggle { get; set; }
}
