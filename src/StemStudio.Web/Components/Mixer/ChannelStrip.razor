@* One stem's channel strip: meter, fader (0-100 %), pan (-100 L..100 R), mute and solo (FR-011). *@

<div class="ss-strip @(Audible ? null : "ss-strip-silent")" role="group" aria-label="@($"{Channel.Stem} channel")"
     data-testid="@($"strip-{Channel.Stem}")">
    <span class="ss-strip-name">@Channel.Stem</span>
    <Meter Target="@Channel.Stem" />
    <input type="range" class="ss-fader" min="0" max="100" step="1" value="@Volume" aria-valuenow="@Volume"
           aria-valuemin="0" aria-valuemax="100" aria-label="@($"{Channel.Stem} volume")" aria-orientation="vertical"
           @oninput="VolumeInput" data-testid="@($"fader-{Channel.Stem}")" />
    <input type="range" class="ss-pan" min="-100" max="100" step="1" value="@Pan" aria-valuenow="@Pan"
           aria-valuemin="-100" aria-valuemax="100" aria-label="@($"{Channel.Stem} pan")" aria-valuetext="@PanText"
           @oninput="PanInput" data-testid="@($"pan-{Channel.Stem}")" />
    <div class="ss-strip-buttons">
        <RadzenButton Text="M" Size="ButtonSize.Small" ButtonStyle="@(Channel.Mute ? ButtonStyle.Danger : ButtonStyle.Light)"
                      aria-pressed="@Bool(Channel.Mute)" aria-label="@($"Mute {Channel.Stem}")" Click="OnMute"
                      data-testid="@($"mute-{Channel.Stem}")" />
        <RadzenButton Text="S" Size="ButtonSize.Small" ButtonStyle="@(Channel.Solo ? ButtonStyle.Warning : ButtonStyle.Light)"
                      aria-pressed="@Bool(Channel.Solo)" aria-label="@($"Solo {Channel.Stem}")" Click="OnSolo"
                      data-testid="@($"solo-{Channel.Stem}")" />
    </div>
</div>
