@* Transpose of the whole mix -12..12 semitones (012 FR-002, FR-017; ui-test-ids 1.11.0 practice-transpose*). A spinbutton
   that shows "+2" and speaks "+2 semitones"; Arrow Up/Down change it (web-interop keeps the page from scrolling). *@

<div class="ss-practice-row">
    <span id="practice-transpose-label" class="ss-inline-label ss-practice-label">Transpose</span>
    <RadzenButton Text="-1" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Disabled="Disabled" aria-label="Down one semitone"
                  Click="() => Emit(Value - 1)" data-testid="practice-transpose-down" />
    <div class="ss-practice-value ss-practice-spin" role="spinbutton" tabindex="0" aria-labelledby="practice-transpose-label"
         aria-valuemin="@Min" aria-valuemax="@Max" aria-valuenow="@Value" aria-valuetext="@PracticeText.SpokenSemitones(Value)"
         aria-disabled="@(Disabled ? "true" : null)" data-ss-spin @onkeydown="KeyDown"
         data-testid="practice-transpose" data-help-id="practice-transpose">@PracticeText.Semitones(Value)</div>
    <RadzenButton Text="+1" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Disabled="Disabled" aria-label="Up one semitone"
                  Click="() => Emit(Value + 1)" data-testid="practice-transpose-up" />
    <LevelGate Feature="practice.numeric">
        <input type="number" class="rz-textbox ss-number" min="@Min" max="@Max" step="1" value="@Value" aria-label="Transpose in semitones"
               disabled="@Disabled" @onchange="NumberChanged" data-testid="practice-transpose-input" data-help-id="practice-transpose" />
    </LevelGate>
</div>
