@* Visual count-in above the transport (012 FR-013, FR-017; ui-test-ids 1.11.0 countin-indicator). The dots and the number
   are visual only (one dot per beat, the current beat gets a ring, nothing flashes); screen readers hear "Count-in" when
   it starts and "Go" when the music enters, never every beat, through the persistent announcer. *@

<span class="ss-sr-only" role="status" aria-live="polite" data-countin-announcer>@_announcement</span>
@if (Status.Active)
{
    <div class="ss-countin" role="status" aria-live="polite" aria-label="Count-in" data-testid="countin-indicator"
         data-beats-remaining="@Status.BeatsRemaining" data-beats-total="@Status.BeatsTotal">
        <span class="ss-countin-number" aria-hidden="true">@Status.BeatsRemaining</span>
        <ol class="ss-countin-dots" aria-hidden="true">
            @for (var beat = 1; beat <= Status.BeatsTotal; beat++)
            {
                <li class="ss-countin-dot" data-state="@DotState(beat)" data-testid="@($"countin-dot-{beat}")"></li>
            }
        </ol>
    </div>
}
