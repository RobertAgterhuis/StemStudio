@page "/tracks/{Id:guid}/mixer"
@using StemStudio.Web.Components.Recording
@using StemStudio.Web.Components.Practice
@using StemStudio.Contracts.Sections

<PageTitle>Mixer - StemStudio</PageTitle>

<NavigationLock OnBeforeInternalNavigation="ConfirmLeaveAsync" ConfirmExternalNavigation="@(State?.IsDirty == true)" />

@if (LoadError is not null)
{
    <ErrorState TestId="mixer-load-error" Message="@LoadError" Hint="Open the track page to follow its processing."><a href="tracks">Back to tracks</a></ErrorState>
}
else if (State is null)
{
    <Skeleton Lines="6" />
}
else
{
    <SectionContent SectionName="@ContextBar.JourneySection"><JourneyRail Stage="JourneyStages.ForMixer(State.MixId is not null, State.IsDirty)" /></SectionContent>
    <div class="ss-console">
        <header class="ss-console-head">
            <TrackArtwork Track="_track!" TestId="mixer-cover" HelpId="artwork" />
            <div class="ss-console-title">
                <h1>@Title</h1>
                @if (MetadataStatusText.AlbumLine(_track!.Metadata) is { } album)
                {
                    <span class="ss-muted" data-testid="mixer-album">@album</span>
                }
                @if (State.MixName is not null)
                {
                    <span class="ss-mix-name" data-testid="mix-name">@State.MixName</span>
                }
                @if (State.IsDirty)
                {
                    <span class="ss-unsaved" role="status" data-testid="unsaved-indicator">Unsaved changes</span>
                }
            </div>
            <div class="ss-mix-actions">
                <BandInfoToggle Open="ShowBandInfo" OnToggle="ToggleBandInfo" />
                <RecordingToolbarToggle Mixer="this" />
                @if (!IsBeginner)
                {
                    <PresetPicker Presets="Presets" OnApply="ApplyPresetAsync" />
                }
                <RadzenButton Text="Save to library" Icon="library_add" ButtonStyle="ButtonStyle.Light" Click="OpenExport" data-testid="mixer-export"
                              data-help-id="export-dialog" />
                <RadzenButton Text="Save as" Icon="save_as" ButtonStyle="ButtonStyle.Light" Click="OpenSaveAs" data-testid="mix-save-as" />
                <RadzenButton Text="Save" Icon="save" Click="SaveAsync" data-testid="mix-save" data-help-id="mixer-save" />
            </div>
            @if (MixError is not null && !DialogOpen)
            {
                <ErrorState TestId="mix-error" Message="@MixError" />
            }
        </header>

        @if (ShowBandInfo)
        {
            <BandInfoPanel Track="_track" OnClose="ToggleBandInfo" OnChanged="RefreshTrackAsync" />
        }

        @if (Exporting is not null)
        {
            <ExportDialog Target="Exporting" OnClose="CloseExport" />
        }

        @if (DialogOpen)
        {
            <SaveMixDialog Title="Save mix as" Name="@DialogName" Error="@DialogError" OnConfirm="ConfirmSaveAsAsync" OnCancel="CloseDialog" />
        }

        @if (EngineError is not null)
        {
            <ErrorState TestId="mixer-engine-error" Message="@EngineError" />
        }
        @if (!EngineReady && EngineError is null)
        {
            <p class="ss-muted" role="status" data-testid="mixer-loading">Loading stems...</p>
        }

        @if (IsBeginner)
        {
            <PresetPicker Presets="Presets" OnApply="ApplyPresetAsync" />
        }

        <SectionLane TrackId="Id" Set="State.SectionSet" Position="Position" Loop="State.Loop" OnLoaded="OnSectionsLoaded" OnLoop="LoopSectionAsync"
                     OnCommand="SectionCommandAsync">
            <Actions>
                <LevelGate Feature="sections.edit">
                    <RadzenButton Text="Edit sections" Icon="edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Disabled="@(State.SectionSet?.Status != SectionSetStatusDto.Ready)"
                                  Click="OpenSectionEditor" aria-expanded="@(EditingSections ? "true" : "false")" data-testid="section-edit" data-help-id="section-editor" />
                </LevelGate>
                <LevelGate Feature="sections.detect-again">
                    <RadzenButton Text="Detect again" Icon="auto_awesome" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="DetectAgainAsync"
                                  data-testid="section-detect-again" data-help-id="section-status" />
                </LevelGate>
            </Actions>
            <ItemExtra Context="section">
                <LevelGate Feature="sections.confidence">
                    @if (section.Confidence is { } confidence)
                    {
                        <span class="ss-muted ss-section-confidence" data-testid="@($"section-confidence-{section.Id}")">@ConfidenceText(confidence)</span>
                    }
                </LevelGate>
            </ItemExtra>
        </SectionLane>
        @if (EditingSections && State.SectionSet is { } editing)
        {
            <SectionEditor TrackId="Id" Set="editing" Duration="State.Duration" BeatGrid="_track?.BeatGrid" Position="Position"
                           Channels="@(State.Channels.Select(c => c.Stem).ToList())" OnSaved="OnSectionsSaved" OnCancel="CloseSectionEditor" />
        }
        @if (ConfirmOverwrite)
        {
            <ConfirmModal Title="Replace your edited sections?" Message="Detecting again replaces the sections you edited with new detected ones."
                          ConfirmText="Replace" TestIdPrefix="section-overwrite" OnConfirm="() => DetectAsync(true)" OnCancel="() => ConfirmOverwrite = false" />
        }

        <div class="ss-console-panels">
            <LoopControls Start="State.LoopStart" End="State.LoopEnd" Enabled="State.LoopEnabled" Error="@State.LoopError"
                          Position="Position" OnStart="SetLoopStartAsync" OnEnd="SetLoopEndAsync" OnToggle="ToggleLoopAsync" />
            <MetronomePanel Settings="State.Metronome" Grid="_track?.BeatGrid" OnChange="SetMetronomeAsync" OnReset="ResetMetronomeAsync" />
            <PracticePanel Settings="State.Practice" Status="PracticeLive" TrackBpm="TrackBpm" OnSpeed="SetSpeedAsync" OnTranspose="SetTransposeAsync"
                           OnReset="ResetPracticeAsync">
                <CountInControl Settings="State.Practice.CountIn" LastBars="State.LastCountInBars" Available="@(TrackBpm is not null)"
                                LoopProblem="@PracticeRules.LoopProblem(State.Loop)" OnToggle="ToggleCountInAsync" OnBars="SetCountInBarsAsync"
                                OnEveryPass="SetCountInEveryPassAsync" />
                <SpeedTrainerPanel Settings="State.Practice.Trainer" Status="PracticeLive.Trainer" LoopProblem="@PracticeRules.LoopProblem(State.Loop)" RegionLabel="@TrainerRegion"
                                   Unavailable="StretchUnavailable" OnChange="SetTrainerAsync" OnToggle="ToggleTrainerAsync" />
            </PracticePanel>
        </div>

        <RecordingArea Mixer="this" />

        @if (State.KeepsRemovedDetailSettings)
        {
            <p class="ss-notice" role="note" data-testid="mixer-detail-removed" data-help-id="mixer-detail-removed">
                The detail stems of this track were removed to free space. Their channels are not loaded; the stems they came from play as usual.
                The mix keeps its detail settings: Split further on the track page brings the detail stems back.
            </p>
        }

        <div class="ss-console-desk">
            <section class="ss-strips ss-console-strips" aria-label="Channels">
                @foreach (var channel in State.Channels)
                {
                    var group = State.GroupOf(channel.Stem);
                    <ChannelStrip Channel="channel" Audible="State.IsAudible(channel)" Expanded="group?.Expanded" Selected="channel.Stem == SelectedStem"
                                  OnVolume="v => SetVolumeAsync(channel.Stem, v)" OnPan="p => SetPanAsync(channel.Stem, p)"
                                  OnMute="() => ToggleMuteAsync(channel.Stem)" OnSolo="() => ToggleSoloAsync(channel.Stem)">
                        @if (group is not null)
                        {
                            <ExpandToggle Parent="@group.Parent" Expanded="group.Expanded" Busy="IsExpanding(group.Parent)"
                                          OnToggle="() => ToggleExpandAsync(group.Parent)" />
                        }
                    </ChannelStrip>
                    @if (group is { Expanded: true })
                    {
                        <StemGroup Group="group" IsAudible="State.IsAudible" OnVolume="c => SetVolumeAsync(c.Id, c.Value)"
                                   OnPan="c => SetPanAsync(c.Id, c.Value)" OnMute="ToggleMuteAsync" OnSolo="ToggleSoloAsync" />
                    }
                }
                <TakeStripSlot Mixer="this" />
            </section>
            <div class="ss-console-master">
                <MasterSection Volume="State.MasterVolume" OnVolume="SetMasterAsync" />
            </div>
        </div>

        <div class="ss-mixer-dock">
            <KaraokeBanner @ref="_karaoke" TrackId="Id" EngineReady="EngineReady" />
            <div class="ss-countin-slot"><CountInIndicator Status="PracticeLive.CountIn" /></div>
            <TransportBar Ready="EngineReady" Position="Position" Duration="State.Duration" State="Playback" OnPlay="PlayAsync" OnPause="PauseAsync"
                          OnStop="StopAsync" OnSeek="SeekAsync" />
        </div>
    </div>
}
