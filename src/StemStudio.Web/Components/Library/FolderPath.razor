@* The folder path of a library item, "Artist > Album > Song", as three links (feature 022, FR-012, ui-test-ids 1.22.0
   asset-path-<assetId>, export-saved-folder, score-saved-folder); in search results with the matched parts marked.
   The separators are hidden from screen readers. *@

<span class="ss-folder-path" data-testid="@TestId"><a href="@LibraryLocation.FolderUrl(Placement.Artist.FolderId)"><MarkedText Text="@Placement.Artist.Name" Highlights="Highlights" Field="SearchFieldDto.Artist" /></a><span class="ss-folder-sep" aria-hidden="true"> &gt; </span><a href="@LibraryLocation.FolderUrl(Placement.Album.FolderId)"><MarkedText Text="@Placement.Album.Name" Highlights="Highlights" Field="SearchFieldDto.Album" /></a><span class="ss-folder-sep" aria-hidden="true"> &gt; </span><a href="@LibraryLocation.FolderUrl(Placement.Song.FolderId)"><MarkedText Text="@Placement.Song.Name" Highlights="Highlights" Field="SearchFieldDto.Song" /></a></span>

@code {
    /// <summary>Where the item is filed.</summary>
    [Parameter, EditorRequired]
    public PlacementDto Placement { get; set; } = default!;

    /// <summary>The <c>data-testid</c> of the path.</summary>
    [Parameter, EditorRequired]
    public string TestId { get; set; } = string.Empty;

    /// <summary>Search highlights of the item (artist, album, song fields), or none.</summary>
    [Parameter]
    public IReadOnlyList<HighlightDto> Highlights { get; set; } = [];
}
