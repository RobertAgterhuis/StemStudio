@page "/library"
@page "/library/{FolderId}"
@implements IAsyncDisposable
@* The library (features 007 and 022; ui-test-ids 1.22.0): folders by artist, album and song with the live search on
   every level; "All items" (/library?view=all, Advanced) keeps the 007 flat list. The search results replace the
   folder view while the box has text; clearing it returns to the folder that was open. *@

<PageTitle>@Title - StemStudio</PageTitle>

@if (ShowAllItems)
{
    <AllItemsView Highlight="Highlight" />
}
else
{
    <div class="ss-page ss-page-wide ss-library" data-help-id="library">
        <LibrarySearchBox @ref="_box" Controller="Search" Status="@Announcer.Message" FolderId="@Location.FolderId" OnArrowDown="FocusFirstResultAsync" />
        @if (Search.IsActive)
        {
            <SearchResults @ref="_results" Result="Search.Result" Error="@Search.Error" OnClear="Search.ClearAsync" OnShowAll="ShowAllAsync"
                           OnChanged="Search.RefreshAsync" />
        }
        else
        {
            <FolderView @key="Location.FolderId" FolderId="@Location.FolderId" OnSearchRequested="() => FocusSearchAsync().AsTask()" />
        }
    </div>
}
