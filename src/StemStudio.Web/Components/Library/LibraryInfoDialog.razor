@inherits ModalDialog
@* Edit library info (feature 022, US4, FR-031..FR-033; ui-test-ids 1.22.0 library-info-*; every level): for a track or
   one item, the artist, album and song name used for filing, each with "Automatic" showing the automatic name and its
   source; Reset makes all automatic; the track scope links to the 005 band info lookup. *@

<div class="ss-modal-backdrop">
    <div class="ss-modal ss-library-info-dialog" role="dialog" aria-modal="true" aria-labelledby="library-info-title" data-testid="library-info-dialog"
         data-scope="@ScopeName" data-help-id="library-info" @onkeydown="OnKeyAsync">
        <div class="ss-label-row">
            <h2 id="library-info-title" class="ss-title" tabindex="-1" @ref="InitialFocus">Edit library info</h2>
            <HelpHint HelpId="library-info" />
        </div>
        <p class="ss-help">@Intro</p>

        @if (!Loaded)
        {
            @if (Error is null)
            {
                <Skeleton Lines="3" Label="Loading the library info..." />
            }
        }
        else
        {
            @foreach (var field in Form.Fields)
            {
                <div class="ss-field">
                    <label class="ss-label" for="@($"library-info-{field.Level}")">@field.Label</label>
                    <input id="@($"library-info-{field.Level}")" class="rz-textbox ss-wide" maxlength="@ContractLimits.LibraryNameMaxLength" value="@field.Text"
                           placeholder="@field.AutomaticName" @oninput="args => OnInput(field, args)" aria-invalid="@(field.Problem is null ? null : "true")"
                           aria-describedby="@(field.Problem is null ? null : $"library-info-{field.Level}-problem")" data-testid="@($"library-info-{field.Level}")" />
                    <label class="ss-check">
                        <input type="checkbox" checked="@field.Automatic" @onchange="args => OnAutomatic(field, args)" data-testid="@($"library-info-auto-{field.Level}")" />
                        Automatic: @field.AutomaticName (@field.AutomaticSource)
                    </label>
                    @if (field.Problem is { } problem)
                    {
                        <span id="@($"library-info-{field.Level}-problem")" class="ss-error ss-small">@problem</span>
                    }
                </div>
            }
        }

        @if (Error is not null)
        {
            <div class="ss-error" role="alert" data-testid="library-info-error">@Error</div>
        }

        @if (Target.Scope == LibraryInfoScope.Track)
        {
            <p class="ss-small"><a href="@($"tracks/{Target.Id}")" data-testid="library-info-lookup">Look up band info again</a> on the track page when the artist or title itself is wrong.</p>
        }

        <div class="ss-dialog-actions">
            <RadzenButton Text="Reset" Icon="restart_alt" ButtonStyle="ButtonStyle.Light" Disabled="@(!Loaded || Busy)" Click="ResetAsync" data-testid="library-info-reset" />
            <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="OnClose" data-testid="library-info-cancel" />
            <RadzenButton Text="Save" Icon="check" Disabled="@(!Loaded || Busy)" Click="SaveAsync" data-testid="library-info-save" />
        </div>
    </div>
</div>
