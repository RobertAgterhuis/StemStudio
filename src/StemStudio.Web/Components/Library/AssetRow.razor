@* One library item (feature 007, ui-test-ids 1.5.0): name, contents and format, source track, status (a progressbar while
   rendering), player and download when ready. *@
@using StemStudio.Contracts.Assets
@inject Microsoft.Extensions.Options.IOptions<StemStudioWebOptions> Options

<tr data-testid="@($"asset-row-{Asset.Id}")" data-status="@AssetText.Value(Asset.Status)" aria-current="@(Highlighted ? "true" : null)"
    class="@(Highlighted ? "ss-row-highlight" : null)">
    <td class="ss-cell-title">
        <span class="ss-asset-name" data-testid="@($"asset-name-{Asset.Id}")">@Asset.Name</span>
        <span class="ss-small ss-muted ss-asset-facts">
            <span data-testid="@($"asset-contents-{Asset.Id}")">@Asset.Provenance.Contents</span>@Facts
        </span>
    </td>
    <td>
        @if (Asset.Provenance is { TrackAvailable: true, TrackId: { } trackId })
        {
            <a href="@($"tracks/{trackId}")" data-testid="@($"asset-source-{Asset.Id}")" data-track-available="true">@Asset.Provenance.TrackTitle</a>
        }
        else
        {
            <span class="ss-muted" data-testid="@($"asset-source-{Asset.Id}")" data-track-available="false">@Asset.Provenance.TrackTitle (deleted)</span>
        }
    </td>
    <td>
        @if (Asset.Status == AssetStatusDto.Rendering)
        {
            <span class="ss-asset-status" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@Asset.Progress"
                  aria-label="@($"Preparing {Asset.Name}")" data-testid="@($"asset-status-{Asset.Id}")">@AssetText.Status(Asset)</span>
        }
        else
        {
            <span class="@($"ss-asset-status ss-asset-{AssetText.Value(Asset.Status)}")" data-testid="@($"asset-status-{Asset.Id}")">@AssetText.Status(Asset)</span>
        }
    </td>
    <td class="ss-num"><time datetime="@Asset.CreatedAt.UtcDateTime.ToString("yyyy-MM-ddTHH:mm:ssZ", System.Globalization.CultureInfo.InvariantCulture)">@Asset.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.InvariantCulture)</time></td>
    <td class="ss-cell-action">
        @if (Asset.Status == AssetStatusDto.Ready)
        {
            <div class="ss-row-actions">
                <audio controls preload="none" src="@FileUrl(true)" aria-label="@($"Play {Asset.Name}")" data-testid="@($"asset-play-{Asset.Id}")"></audio>
                <a class="ss-row-action" href="@FileUrl(false)" download aria-label="@($"Download {Asset.Name}")" data-testid="@($"asset-download-{Asset.Id}")">Download</a>
            </div>
        }
    </td>
</tr>

@code {
    /// <summary>The item.</summary>
    [Parameter, EditorRequired]
    public AssetDto Asset { get; set; } = default!;

    /// <summary>True for the item opened from an export confirmation.</summary>
    [Parameter]
    public bool Highlighted { get; set; }

    private string Facts => AssetText.Format(Asset.Audio) is { } format
        ? $" · {format} · {TimeText.Duration(Asset.Audio!.DurationSeconds)} · {ByteSize.Format(Asset.SizeBytes)}"
        : string.Empty;

    private string FileUrl(bool inline) =>
        new Uri(Options.Value.PublicApiBaseUrl, ApiRoutes.AssetFile(Asset.Id, ApiRoutes.AssetFileAudio, inline)).ToString();
}
