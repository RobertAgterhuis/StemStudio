@page "/styles"
@* The style library (009 US2, FR-003, FR-004; ui-test-ids 1.8.0): curated presets and own styles in the library order
   (presets first, then by name) with filters and search. Styles stay usable without a GPU. *@

<PageTitle>Styles - StemStudio</PageTitle>

<div class="ss-page ss-page-wide ss-styles-page">
    <header class="ss-page-head ss-page-head-row" data-help-id="styles-library">
        <div>
            <div class="ss-label-row"><h1>Styles</h1><HelpHint HelpId="styles-library" /></div>
            <p class="ss-help">Styles describe music: genre, instruments, mood and tempo feel. Use them to restyle a track.</p>
        </div>
    </header>

    @if (Error is not null)
    {
        <ErrorState TestId="styles-error" Message="@Error" Hint="Check that StemStudio is running, then reload the page." />
    }
    else if (Items is null)
    {
        <Skeleton Lines="4" />
    }
    else
    {
        <StyleFilters Styles="Items" Filter="Filter" OnChanged="StateHasChanged" />
        @if (Visible.Count == 0)
        {
            <EmptyState TestId="style-empty" Text="No styles match the filters." />
        }
        else
        {
            <table class="ss-table ss-style-table">
                <thead>
                    <tr>
                        <th>Style</th><th>Genre</th><th>Tempo feel</th><th>Moods</th><th>Instruments</th><th>Vocals</th><th>Strength</th>
                        <th><span class="ss-sr-only">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var style in Visible)
                    {
                        <StyleRow @key="style.Id" Style="style" />
                    }
                </tbody>
            </table>
        }
    }
</div>
