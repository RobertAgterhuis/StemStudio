@* Tag input of the style editor (ui-test-ids 1.8.0 style-mood-tags, style-instrument-tags): type a tag and press Enter
   or "Add"; each tag has a remove button named after it. The tags are a list, so screen readers count them. *@

<div class="ss-field ss-tag-input">
    <label class="ss-label" for="@TestId">@Label</label>
    <div class="ss-row">
        <input id="@TestId" type="text" class="rz-textbox" maxlength="30" value="@Draft" @oninput="e => Draft = (string)e.Value!"
               @onkeydown="OnKeyAsync" data-testid="@TestId" />
        <RadzenButton Text="Add" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="AddAsync" data-testid="@($"{TestId}-add")" />
    </div>
    <ul class="ss-tags" aria-label="@Label" data-testid="@ListTestId">
        @foreach (var tag in Tags)
        {
            <li class="ss-tag">@tag<button type="button" class="ss-tag-remove" aria-label="@($"Remove {tag}")" @onclick="() => OnRemove.InvokeAsync(tag)"></button></li>
        }
    </ul>
    <span class="ss-help ss-small">Up to 8 tags, press Enter after each.</span>
</div>
