@* The drum trainer (016 US3, FR-031..FR-034, FR-062; ui-test-ids 1.15.0 drum-*): hit status, the split notice, five lane
   labels (guide piece at Advanced), the engine-owned lane host (rendered empty), the bar as text, the limits and the drum
   notation. Lives in the scrolling mixer content, never in the fixed dock. *@

<div class="ss-drum-trainer" role="group" aria-label="Drum trainer" data-testid="drum-trainer" data-help-id="drum-trainer">
    <div class="ss-drum-bar">
        <span class="ss-small" role="status" data-testid="drum-hits-status" data-status="@WireStatus">@StatusText</span>
        <LevelGate Feature="drums.guide">
            <label class="ss-inline-label">
                Look-ahead @LookAheadText
                <input type="range" class="ss-range" min="@MinLookAhead" max="@MaxLookAhead" step="500" value="@LookAheadMs"
                       aria-valuenow="@LookAheadMs" aria-valuetext="@LookAheadText" @onchange="SetLookAheadAsync" data-testid="drum-look-ahead" />
            </label>
        </LevelGate>
        <HelpHint HelpId="drum-trainer" />
    </div>
    @if (Error is not null)
    {
        <p class="ss-small ss-error" role="alert">@Error</p>
    }
    @if (SplitRequired)
    {
        <div class="ss-notice" role="note" data-testid="drum-hits-split-required">
            <span>@SplitText</span>
            <RadzenButton Text="Split the drums" Icon="call_split" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Disabled="Splitting"
                          Click="StartSplitAsync" data-testid="drum-hits-split-start" />
        </div>
    }
    <div class="ss-drum-view">
        <div class="ss-drum-lane-labels" role="group" aria-label="Drum lanes">
            @foreach (var piece in LaneOrder)
            {
                <button type="button" class="ss-text-button ss-drum-lane-label" disabled="@(!CanGuide(piece))" aria-pressed="@Pressed(piece)"
                        @onclick="() => ToggleGuideAsync(piece)" data-testid="@($"drum-lane-label-{WireName.Of(piece)}")">@DrumBarText.Piece(piece)</button>
            }
        </div>
        @if (Events is not null)
        {
            <div id="@HostId" @key="Events" class="ss-drum-lanes" role="img" data-testid="drum-lanes" data-help-id="drum-lanes"
                 aria-label="Drum hit lanes: cymbals, hi-hat, toms, snare and kick; the hits of the current bar are also listed as text"></div>
        }
    </div>
    <div class="ss-sr-only" data-testid="drum-bar-text">
        <p>@Bar.Heading</p>
        @if (Bar.Hits.Count == 0)
        {
            <p>No hits in this bar.</p>
        }
        else
        {
            <ul>
                @foreach (var hit in Bar.Hits)
                {
                    <li>@hit</li>
                }
            </ul>
        }
    </div>
    @if (Analysis is { Limits: { Length: > 0 } limits })
    {
        <p class="ss-small ss-muted ss-drum-limits">@limits</p>
    }
    <section class="ss-drum-score" aria-label="Drum notation" data-testid="drum-score">
        @if (HasDrumScore)
        {
            @ScoreView
        }
        else if (Scores is not null)
        {
            <p class="ss-small ss-muted">No drum notation for this song yet.</p>
            <RadzenButton Text="Generate drum notation" Icon="music_note" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Disabled="Making"
                          Click="StartGenerate" data-testid="drum-score-generate" />
            @if (Making)
            {
                <span class="ss-small ss-muted" role="status">Making the drum notation: @MakingProgress %</span>
            }
            @if (ScoreError is not null)
            {
                <p class="ss-small ss-error" role="alert">@ScoreError</p>
            }
        }
    </section>
</div>
