<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Blazor Web App, Interactive Server render mode, Radzen (ADR-002). Depends on Contracts only.
       wwwroot/js/audio-engine.js is produced by src/audio-engine and wwwroot/js/{web-interop,first-paint}.js
       by src/web-interop (npm run build). Owned by the frontend agent; package references and the help
       resources below are the architect's skeleton (feature 004, T002). -->
  <PropertyGroup>
    <RootNamespace>StemStudio.Web</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\StemStudio.Contracts\StemStudio.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="StemStudio.Web.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Radzen.Blazor" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>
  <ItemGroup>
    <!-- Help content (contracts/help-content.md 1): topics and tours are embedded and loaded once at start-up.
         Manifest names: StemStudio.Web.Help.topics.<area>.<id>.md and StemStudio.Web.Help.tours.<id>.json. -->
    <Content Remove="Help\**" />
    <None Remove="Help\**" />
    <EmbeddedResource Include="Help\topics\**\*.md;Help\tours\*.json" />
  </ItemGroup>
  <ItemGroup>
    <!-- Default key map catalogue (web-interop 1.1.0 5.4): served to the browser and embedded for KeyMapDefaults.Catalogue. -->
    <EmbeddedResource Include="wwwroot\js\keymap-defaults.json" LogicalName="StemStudio.Web.keymap-defaults.json" />
  </ItemGroup>
</Project>
