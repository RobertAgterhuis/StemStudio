{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$status": "SYNCED",
  "$syncedAt": "2026-11-17",
  "$description": "Tipoca default design tokens. Snapshot of the Superdesign default project (private; snapshot). Entries with $extensions.tipoca.derived = true are not in the source; Tipoca added them for light mode and accessibility.",
  "color": {
    "dark": {
      "bg": {
        "canvas": { "$type": "color", "$value": "#050505" },
        "sunken": { "$type": "color", "$value": "#0a0a0a" },
        "mesh-1": { "$type": "color", "$value": "#1a1a1a", "$description": "Radial mesh stop, top-left and bottom-right" },
        "mesh-2": { "$type": "color", "$value": "#2d0a0f", "$description": "Radial mesh stop, top-right (crimson tint)" },
        "mesh-3": { "$type": "color", "$value": "#111111", "$description": "Radial mesh stop, bottom-left" },
        "glow": { "$type": "color", "$value": "rgba(220, 20, 60, 0.06)", "$description": "800px radial orb, blur 80px" }
      },
      "surface": {
        "panel": { "$type": "color", "$value": "rgba(15, 15, 15, 0.45)", "$description": "Backdrop blur 20px" },
        "card": { "$type": "color", "$value": "rgba(20, 20, 20, 0.40)", "$description": "Backdrop blur 24px" },
        "window": { "$type": "color", "$value": "rgba(10, 10, 10, 0.70)", "$description": "Backdrop blur 32px" },
        "subtle": { "$type": "color", "$value": "rgba(255, 255, 255, 0.03)" },
        "solid-fallback": { "$type": "color", "$value": "#0f0f0f", "$extensions": { "tipoca": { "derived": true } } }
      },
      "fill": {
        "control": { "$type": "color", "$value": "rgba(255, 255, 255, 0.05)" },
        "control-hover": { "$type": "color", "$value": "rgba(255, 255, 255, 0.10)" },
        "control-focus": { "$type": "color", "$value": "rgba(255, 255, 255, 0.08)" },
        "row-hover": { "$type": "color", "$value": "rgba(255, 255, 255, 0.02)" }
      },
      "border": {
        "subtle": { "$type": "color", "$value": "rgba(255, 255, 255, 0.05)" },
        "default": { "$type": "color", "$value": "rgba(255, 255, 255, 0.08)" },
        "control": { "$type": "color", "$value": "rgba(255, 255, 255, 0.10)" },
        "strong": { "$type": "color", "$value": "rgba(255, 255, 255, 0.20)" }
      },
      "text": {
        "primary": { "$type": "color", "$value": "#ffffff" },
        "secondary": { "$type": "color", "$value": "rgba(255, 255, 255, 0.70)" },
        "muted": { "$type": "color", "$value": "rgba(255, 255, 255, 0.60)", "$description": "Tipoca minimum for readable text (about 7:1). The source uses 0.40, which fails AA.", "$extensions": { "tipoca": { "derived": true } } },
        "faint": { "$type": "color", "$value": "rgba(255, 255, 255, 0.40)", "$description": "Decorative or disabled only" },
        "placeholder": { "$type": "color", "$value": "#6b7280" }
      },
      "accent": {
        "default": { "$type": "color", "$value": "#DC143C", "$description": "Crimson. Text use only at 18px+ or 14px+ bold (about 4.1:1 on canvas)." },
        "hover": { "$type": "color", "$value": "#B21032" },
        "deep": { "$type": "color", "$value": "#8B0000", "$description": "Gradient end" },
        "tint": { "$type": "color", "$value": "rgba(220, 20, 60, 0.15)" },
        "tint-subtle": { "$type": "color", "$value": "rgba(220, 20, 60, 0.10)" },
        "border": { "$type": "color", "$value": "rgba(220, 20, 60, 0.20)" },
        "text": { "$type": "color", "$value": "#FF4D6D", "$description": "Small crimson text and focus ring (about 6.3:1)", "$extensions": { "tipoca": { "derived": true } } },
        "on-accent": { "$type": "color", "$value": "#ffffff" }
      },
      "status": {
        "success": { "$type": "color", "$value": "#10b981" },
        "success-text": { "$type": "color", "$value": "#34d399" },
        "warning": { "$type": "color", "$value": "#f59e0b" },
        "warning-text": { "$type": "color", "$value": "#fbbf24" },
        "info": { "$type": "color", "$value": "#3b82f6" },
        "info-text": { "$type": "color", "$value": "#60a5fa" },
        "danger": { "$type": "color", "$value": "#ef4444" },
        "danger-text": { "$type": "color", "$value": "#f87171" }
      },
      "accent-alternatives": {
        "blue": { "$type": "color", "$value": "#3b82f6" },
        "emerald": { "$type": "color", "$value": "#10b981" },
        "amber": { "$type": "color", "$value": "#f59e0b" },
        "violet": { "$type": "color", "$value": "#8b5cf6" },
        "pink": { "$type": "color", "$value": "#ec4899" },
        "white": { "$type": "color", "$value": "#ffffff" }
      }
    },
    "light": {
      "$description": "Derived; the source is dark-only.",
      "$extensions": { "tipoca": { "derived": true } },
      "bg": {
        "canvas": { "$type": "color", "$value": "#f7f7f8" },
        "sunken": { "$type": "color", "$value": "#efeff1" }
      },
      "surface": {
        "panel": { "$type": "color", "$value": "rgba(255, 255, 255, 0.60)" },
        "card": { "$type": "color", "$value": "rgba(255, 255, 255, 0.70)" },
        "window": { "$type": "color", "$value": "rgba(255, 255, 255, 0.80)" }
      },
      "fill": {
        "control": { "$type": "color", "$value": "rgba(0, 0, 0, 0.04)" },
        "control-hover": { "$type": "color", "$value": "rgba(0, 0, 0, 0.08)" }
      },
      "border": {
        "default": { "$type": "color", "$value": "rgba(0, 0, 0, 0.08)" },
        "strong": { "$type": "color", "$value": "rgba(0, 0, 0, 0.20)" }
      },
      "text": {
        "primary": { "$type": "color", "$value": "#0a0a0a" },
        "secondary": { "$type": "color", "$value": "rgba(0, 0, 0, 0.70)" },
        "muted": { "$type": "color", "$value": "rgba(0, 0, 0, 0.55)" }
      },
      "accent": {
        "default": { "$type": "color", "$value": "#C8102E" },
        "hover": { "$type": "color", "$value": "#A00D25" },
        "text": { "$type": "color", "$value": "#B00E28" },
        "on-accent": { "$type": "color", "$value": "#ffffff" }
      }
    }
  },
  "typography": {
    "family": {
      "sans": { "$type": "fontFamily", "$value": ["Satoshi", "Plus Jakarta Sans", "ui-sans-serif", "system-ui", "sans-serif"], "$description": "Load Satoshi from Fontshare or self-host it; it is not on Google Fonts." },
      "mono": { "$type": "fontFamily", "$value": ["JetBrains Mono", "ui-monospace", "SFMono-Regular", "monospace"] }
    },
    "weight": {
      "light": { "$type": "fontWeight", "$value": 300 },
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "bold": { "$type": "fontWeight", "$value": 700 },
      "black": { "$type": "fontWeight", "$value": 900 }
    },
    "scale": {
      "display": { "$type": "typography", "$value": { "fontFamily": "{typography.family.sans}", "fontSize": "36px", "lineHeight": "40px", "fontWeight": 700, "letterSpacing": "-0.025em" } },
      "h1": { "$type": "typography", "$value": { "fontFamily": "{typography.family.sans}", "fontSize": "30px", "lineHeight": "36px", "fontWeight": 900, "letterSpacing": "-0.025em" } },
      "h2": { "$type": "typography", "$value": { "fontFamily": "{typography.family.sans}", "fontSize": "24px", "lineHeight": "32px", "fontWeight": 700, "letterSpacing": "-0.025em" } },
      "h3": { "$type": "typography", "$value": { "fontFamily": "{typography.family.sans}", "fontSize": "20px", "lineHeight": "28px", "fontWeight": 700, "letterSpacing": "-0.025em" } },
      "h4": { "$type": "typography", "$value": { "fontFamily": "{typography.family.sans}", "fontSize": "18px", "lineHeight": "28px", "fontWeight": 700, "letterSpacing": "0" } },
      "body": { "$type": "typography", "$value": { "fontFamily": "{typography.family.sans}", "fontSize": "14px", "lineHeight": "20px", "fontWeight": 400, "letterSpacing": "0" } },
      "body-long": { "$type": "typography", "$value": { "fontFamily": "{typography.family.sans}", "fontSize": "14px", "lineHeight": "1.625", "fontWeight": 400, "letterSpacing": "0" } },
      "small": { "$type": "typography", "$value": { "fontFamily": "{typography.family.sans}", "fontSize": "12px", "lineHeight": "16px", "fontWeight": 500, "letterSpacing": "0" } },
      "eyebrow": { "$type": "typography", "$value": { "fontFamily": "{typography.family.sans}", "fontSize": "10px", "lineHeight": "14px", "fontWeight": 900, "letterSpacing": "0.2em" }, "$description": "UPPERCASE" },
      "micro": { "$type": "typography", "$value": { "fontFamily": "{typography.family.sans}", "fontSize": "9px", "lineHeight": "12px", "fontWeight": 900, "letterSpacing": "0.1em" }, "$description": "UPPERCASE; badges only" },
      "mono-data": { "$type": "typography", "$value": { "fontFamily": "{typography.family.mono}", "fontSize": "12px", "lineHeight": "16px", "fontWeight": 400, "letterSpacing": "0" } }
    }
  },
  "spacing": {
    "1": { "$type": "dimension", "$value": "4px" },
    "1-5": { "$type": "dimension", "$value": "6px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "20px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" },
    "10": { "$type": "dimension", "$value": "40px" },
    "12": { "$type": "dimension", "$value": "48px" }
  },
  "radius": {
    "xs": { "$type": "dimension", "$value": "6px" },
    "sm": { "$type": "dimension", "$value": "8px" },
    "md": { "$type": "dimension", "$value": "12px", "$description": "Default control radius" },
    "lg": { "$type": "dimension", "$value": "16px" },
    "xl": { "$type": "dimension", "$value": "24px" },
    "2xl": { "$type": "dimension", "$value": "32px", "$description": "Windows and panels" },
    "3xl": { "$type": "dimension", "$value": "40px" },
    "full": { "$type": "dimension", "$value": "9999px" }
  },
  "shadow": {
    "card": { "$type": "shadow", "$value": { "offsetX": "0px", "offsetY": "25px", "blur": "50px", "spread": "-12px", "color": "rgba(0, 0, 0, 0.5)" } },
    "window": { "$type": "shadow", "$value": { "offsetX": "0px", "offsetY": "30px", "blur": "60px", "spread": "-12px", "color": "rgba(0, 0, 0, 0.6)" } },
    "accent-glow": { "$type": "shadow", "$value": { "offsetX": "0px", "offsetY": "10px", "blur": "15px", "spread": "-3px", "color": "rgba(220, 20, 60, 0.2)" } },
    "control-glow": { "$type": "shadow", "$value": { "offsetX": "0px", "offsetY": "0px", "blur": "10px", "spread": "0px", "color": "rgba(220, 20, 60, 0.4)" } },
    "inset": { "$type": "shadow", "$value": { "offsetX": "0px", "offsetY": "2px", "blur": "4px", "spread": "0px", "color": "rgba(0, 0, 0, 0.05)", "inset": true } }
  },
  "blur": {
    "card-subtle": { "$type": "dimension", "$value": "10px" },
    "panel": { "$type": "dimension", "$value": "20px" },
    "card": { "$type": "dimension", "$value": "24px" },
    "window": { "$type": "dimension", "$value": "32px" },
    "glow": { "$type": "dimension", "$value": "80px" }
  },
  "motion": {
    "duration": {
      "fast": { "$type": "duration", "$value": "200ms" },
      "page": { "$type": "duration", "$value": "250ms" },
      "base": { "$type": "duration", "$value": "300ms" },
      "toggle": { "$type": "duration", "$value": "400ms" },
      "slow": { "$type": "duration", "$value": "500ms" },
      "pulse": { "$type": "duration", "$value": "2000ms" }
    },
    "easing": {
      "standard": { "$type": "cubicBezier", "$value": [0.4, 0, 0.2, 1] },
      "pulse": { "$type": "cubicBezier", "$value": [0.4, 0, 0.6, 1] },
      "ease-out": { "$type": "cubicBezier", "$value": [0, 0, 0.58, 1] },
      "ease-in": { "$type": "cubicBezier", "$value": [0.42, 0, 1, 1] }
    },
    "transform": {
      "lift": { "$type": "dimension", "$value": "-4px", "$description": "translateY on tile hover" },
      "nudge": { "$type": "dimension", "$value": "4px", "$description": "translateX on list-card hover" },
      "press-scale": { "$type": "number", "$value": 0.95 },
      "cta-hover-scale": { "$type": "number", "$value": 1.02 }
    }
  },
  "layout": {
    "topbar-height": { "$type": "dimension", "$value": "40px" },
    "rail-width": { "$type": "dimension", "$value": "80px" },
    "dock-height": { "$type": "dimension", "$value": "64px" },
    "panel-gap": { "$type": "dimension", "$value": "24px" },
    "content-max": { "$type": "dimension", "$value": "1152px" },
    "auth-card-max": { "$type": "dimension", "$value": "448px" },
    "grid-columns": { "$type": "number", "$value": 12 }
  },
  "focus": {
    "ring": { "$type": "border", "$value": { "color": "{color.dark.accent.text}", "width": "2px", "style": "solid" }, "$description": "Plus a 2px offset", "$extensions": { "tipoca": { "derived": true } } }
  }
}
